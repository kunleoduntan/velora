{
  "name": "velora-projectone-mobile",
  "version": "1.4.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:build-config": "node scripts/check-build-config.mjs",
    "prebuild:android": "npm run check:build-config && expo prebuild --platform android",
    "ci:verify": "npm test && npm run check:build-config && npm run typecheck",
    "qualify:staging": "node scripts/qualify-staging.mjs",
    "check:release-env": "node scripts/check-release-env.mjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.7",
    "expo-linking": "~8.0.9",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "expo-system-ui": "~6.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
