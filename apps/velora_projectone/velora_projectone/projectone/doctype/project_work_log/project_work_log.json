{
  "name": "Project Work Log",
  "module": "Execution",
  "track_changes": true,
  "description": "Task-level activity log; not a payroll timesheet.",
  "fields": [
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "Project",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "task",
      "label": "Task",
      "fieldtype": "Link",
      "options": "Project Task"
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "work_date",
      "label": "Work Date",
      "fieldtype": "Date",
      "required": true
    },
    {
      "fieldname": "hours",
      "label": "Hours",
      "fieldtype": "Float",
      "required": true
    },
    {
      "fieldname": "work_description",
      "label": "Work Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "billable",
      "label": "Billable",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "approval_status",
      "label": "Approval Status",
      "fieldtype": "Select",
      "options": [
        "Draft",
        "Pending Approval",
        "Approved",
        "Rejected"
      ],
      "default": "Draft"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project User",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "report": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "project"
}