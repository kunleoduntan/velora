{
  "name": "Project Issue",
  "module": "Governance",
  "track_changes": true,
  "description": "Active project issue and blocker register.",
  "fields": [
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "Project",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "issue_code",
      "label": "Issue Code",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "title",
      "label": "Issue Title",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Select",
      "options": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    {
      "fieldname": "issue_owner",
      "label": "Owner",
      "fieldtype": "Data"
    },
    {
      "fieldname": "target_resolution_date",
      "label": "Target Resolution Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "resolution",
      "label": "Resolution",
      "fieldtype": "Text"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": [
        "Draft",
        "Open",
        "In Progress",
        "On Hold",
        "Completed",
        "Cancelled"
      ],
      "default": "Draft",
      "in_list_view": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project User",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "report": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "title"
}