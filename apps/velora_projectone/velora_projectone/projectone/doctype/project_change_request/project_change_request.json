{
  "name": "Project Change Request",
  "module": "Governance",
  "track_changes": true,
  "description": "Controlled project change management.",
  "fields": [
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "Project",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "change_code",
      "label": "Change Code",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "title",
      "label": "Change Title",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Text"
    },
    {
      "fieldname": "scope_impact",
      "label": "Scope Impact",
      "fieldtype": "Text"
    },
    {
      "fieldname": "schedule_impact_days",
      "label": "Schedule Impact (Days)",
      "fieldtype": "Int"
    },
    {
      "fieldname": "cost_impact",
      "label": "Cost Impact",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "resource_impact",
      "label": "Resource Impact",
      "fieldtype": "Text"
    },
    {
      "fieldname": "risk_impact",
      "label": "Risk Impact",
      "fieldtype": "Text"
    },
    {
      "fieldname": "requested_by",
      "label": "Requested By",
      "fieldtype": "Data"
    },
    {
      "fieldname": "approval_status",
      "label": "Approval Status",
      "fieldtype": "Select",
      "options": [
        "Draft",
        "Pending Approval",
        "Approved",
        "Rejected",
        "Withdrawn"
      ],
      "default": "Draft"
    },
    {
      "fieldname": "schedule_change_payload",
      "label": "Schedule Change Payload",
      "fieldtype": "Text",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "schedule_applied",
      "label": "Schedule Applied",
      "fieldtype": "Check",
      "default": 0,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project User",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "report": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "title"
}