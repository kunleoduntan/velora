    },
    {
      "fieldname": "source_name",
      "label": "Source Document",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "source_line",
      "label": "Source Line",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "posting_reference",
      "label": "Accounting Posting Reference",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "posting_date",
      "label": "Posting Date",
      "fieldtype": "Date",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "cost_category",
      "label": "Cost Category",
      "fieldtype": "Link",
      "options": "Project Cost Category",
      "required": true
    },
    {
      "fieldname": "cost_centre",
      "label": "Cost Centre",
      "fieldtype": "Link",
      "options": "Cost Centre"
    },
    {
