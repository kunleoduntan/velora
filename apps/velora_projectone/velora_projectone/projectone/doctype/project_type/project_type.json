{
  "name": "Project Type",
  "module": "Setup",
  "track_changes": true,
  "description": "Configurable project classification.",
  "fields": [
    {
      "fieldname": "type_name",
      "label": "Type Name",
      "fieldtype": "Data",
      "required": true,
      "unique": true
    },
    {
      "fieldname": "default_methodology",
      "label": "Default Methodology",
      "fieldtype": "Select",
      "options": [
        "Waterfall",
        "Agile",
        "Hybrid",
        "Kanban",
        "Custom"
      ]
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project User",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "report": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "type_name"
}