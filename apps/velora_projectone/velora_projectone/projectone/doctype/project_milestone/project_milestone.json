{
  "name": "Project Milestone",
  "module": "Planning",
  "track_changes": true,
  "description": "Project milestone tracking.",
  "fields": [
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Link",
      "options": "Project",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "milestone_code",
      "label": "Milestone Code",
      "fieldtype": "Data",
      "required": true
    },
    {
      "fieldname": "title",
      "label": "Milestone",
      "fieldtype": "Data",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "wbs",
      "label": "WBS",
      "fieldtype": "Link",
      "options": "Project WBS"
    },
    {
      "fieldname": "planned_date",
      "label": "Planned Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "actual_date",
      "label": "Actual Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "acceptance_required",
      "label": "Acceptance Required",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "accepted_by",
      "label": "Accepted By",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": [
        "Draft",
        "Open",
        "In Progress",
        "On Hold",
        "Completed",
        "Cancelled"
      ],
      "default": "Draft",
      "in_list_view": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project User",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "report": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "title"
}