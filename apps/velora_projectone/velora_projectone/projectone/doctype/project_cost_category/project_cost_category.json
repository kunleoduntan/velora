{
  "name": "Project Cost Category",
  "module": "Setup",
  "track_changes": true,
  "description": "Configurable project cost taxonomy.",
  "fields": [
    {
      "fieldname": "category_name",
      "label": "Category Name",
      "fieldtype": "Data",
      "required": true,
      "unique": true
    },
    {
      "fieldname": "category_type",
      "label": "Category Type",
      "fieldtype": "Select",
      "options": [
        "Labour",
        "Materials",
        "Equipment",
        "Subcontract",
        "Travel",
        "Overhead",
        "Other"
      ]
    },
    {
      "fieldname": "direct_cost",
      "label": "Direct Cost",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "billable_default",
      "label": "Billable by Default",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "import": true,
      "print": true,
      "email": true,
      "share": true
    },
    {
      "role": "Project User",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "report": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "category_name"
}