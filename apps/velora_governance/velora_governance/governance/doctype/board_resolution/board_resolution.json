      "label": "Board",
      "options": "Board",
      "in_list_view": true
    },
    {
      "fieldname": "committee",
      "fieldtype": "Link",
      "label": "Committee",
      "options": "Board Committee"
    },
    {
      "fieldname": "meeting",
      "fieldtype": "Link",
      "label": "Meeting",
      "options": "Board Meeting"
    },
    {
      "fieldname": "resolution_type",
      "fieldtype": "Link",
      "label": "Resolution Type",
      "options": "Board Resolution Type",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "resolution_method",
      "fieldtype": "Select",
      "label": "Resolution Method",
      "options": [
        "Voting",
        "Consensus",
        "Written",
        "Circular"
      ],
      "default": "Voting",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "resolution_text",
      "fieldtype": "Text",
      "label": "Resolution Text",
      "required": true
    },
    {
      "fieldname": "resolution_date",
      "fieldtype": "Date",
      "label": "Resolution Date",
      "in_list_view": true
