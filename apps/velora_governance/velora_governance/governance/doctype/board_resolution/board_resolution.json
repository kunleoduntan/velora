        "Open",
        "Closed"
      ],
      "default": "Not Started",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "resolution_status",
      "fieldtype": "Select",
      "label": "Resolution Status",
      "options": [
        "Draft",
        "Adopted",
        "Rejected",
        "Withdrawn",
        "Archived"
      ],
      "default": "Draft",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_threshold_percent",
      "fieldtype": "Int",
      "label": "Approval Threshold Percent",
      "read_only": true
    },
    {
      "fieldname": "votes",
      "fieldtype": "Table",
      "label": "Voting Records",
      "options": "Board Resolution Voting"
    },
    {
      "fieldname": "votes_for",
      "fieldtype": "Int",
      "label": "Votes For",
      "read_only": true
    },
    {
      "fieldname": "votes_against",
      "fieldtype": "Int",
      "label": "Votes Against",
      "read_only": true
    },
    {
      "fieldname": "abstentions",
      "fieldtype": "Int",
      "label": "Abstentions",
      "read_only": true
    },
    {
      "fieldname": "total_votes",
      "fieldtype": "Int",
      "label": "Total Votes",
      "read_only": true
    },
    {
      "fieldname": "vote_result",
      "fieldtype": "Select",
      "label": "Vote Result",
      "options": [
        "Met",
        "Not Met",
        "No Votes"
      ],
      "read_only": true
    },
    {
      "fieldname": "implementation_status",
      "fieldtype": "Select",
      "label": "Implementation Status",
      "options": [
        "Not Started",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Not Started",
      "in_list_view": true
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
