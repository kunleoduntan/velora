  "fields": [
    {
      "fieldname": "resolution_title",
      "fieldtype": "Data",
      "label": "Resolution Title",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "governance_entity",
      "fieldtype": "Link",
      "label": "Governance Entity",
      "options": "Governance Entity",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "board",
