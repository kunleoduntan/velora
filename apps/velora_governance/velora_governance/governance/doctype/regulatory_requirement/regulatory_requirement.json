      "label": "Regulatory Authority",
      "options": "Regulatory Authority",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "jurisdiction",
      "fieldtype": "Data",
      "label": "Jurisdiction",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "requirement_type",
      "fieldtype": "Select",
      "label": "Requirement Type",
