        "Filing",
        "Compliance",
        "Corporate Event",
        "License",
        "Disclosure",
        "Other"
      ],
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "frequency",
      "fieldtype": "Select",
      "label": "Frequency",
      "options": [
        "Annual",
        "Semi-Annual",
        "Quarterly",
        "Monthly",
        "Event-Based",
        "One-Time",
        "Other"
      ],
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "applicable_entity_type",
      "fieldtype": "Link",
      "label": "Applicable Entity Type",
      "options": "Governance Entity Type"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Active",
      "default": 1,
      "in_list_view": true
    }
  ],
