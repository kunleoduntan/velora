      "fieldtype": "Link",
      "label": "Default Framework",
      "options": "Sustainability Framework"
    },
    {
      "fieldname": "enable_esg",
      "fieldtype": "Check",
      "label": "Enable ESG",
      "default": 1
    },
    {
      "fieldname": "enable_ghg",
      "fieldtype": "Check",
      "label": "Enable GHG Accounting",
      "default": 1
    },
    {
      "fieldname": "materiality_section",
      "fieldtype": "Section Break",
      "label": "Materiality"
    },
    {
      "fieldname": "impact_materiality_threshold",
      "fieldtype": "Int",
      "label": "Impact Materiality Threshold (1-5)",
      "default": 3
    },
    {
      "fieldname": "financial_materiality_threshold",
      "fieldtype": "Int",
      "label": "Financial Materiality Threshold (1-5)",
      "default": 3
    },
    {
      "fieldname": "double_materiality_method",
      "fieldtype": "Select",
      "label": "Double Materiality Method",
      "options": [
        "Maximum",
        "Average",
        "Weighted"
      ],
      "default": "Maximum"
    },
    {
      "fieldname": "ghg_section",
      "fieldtype": "Section Break",
      "label": "GHG"
    },
    {
      "fieldname": "scope2_methodology",
      "fieldtype": "Select",
      "label": "Scope 2 Methodology",
      "options": [
        "Location Based",
        "Market Based",
        "Both"
      ],
      "default": "Both"
    },
    {
      "fieldname": "default_data_quality",
      "fieldtype": "Link",
      "label": "Default Data Quality",
      "options": "Sustainability Data Quality"
    },
    {
      "fieldname": "reporting_section",
      "fieldtype": "Section Break",
      "label": "Reporting"
    },
    {
      "fieldname": "report_readiness_threshold",
      "fieldtype": "Int",
      "label": "Report Readiness Threshold Percent",
      "default": 100
