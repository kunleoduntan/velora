    {
      "role": "Sustainability Officer",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "import": false,
      "report": true,
      "print": true
    },
    {
      "role": "Company Secretary",
      "read": true,
      "write": false,
      "create": false,
      "delete": false,
      "export": true,
      "import": false,
      "report": true,
      "print": true
    }
