    {
      "fieldname": "resolution",
      "fieldtype": "Section Break",
      "label": "Resolution Controls"
    },
    {
      "fieldname": "evidence_required",
      "fieldtype": "Check",
      "label": "Require Resolution Evidence",
      "default": 1
