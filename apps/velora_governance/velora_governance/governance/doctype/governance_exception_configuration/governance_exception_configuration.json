      "label": "Severity Routing"
    },
    {
      "fieldname": "route_low",
      "fieldtype": "Data",
      "label": "Low Severity Route"
    },
    {
      "fieldname": "route_medium",
      "fieldtype": "Data",
      "label": "Medium Severity Route"
    },
    {
      "fieldname": "route_high",
      "fieldtype": "Data",
      "label": "High Severity Route"
    },
    {
      "fieldname": "route_critical",
      "fieldtype": "Data",
      "label": "Critical Severity Route"
    },
    {
