      "label": "Overdue Severity Thresholds"
    },
    {
      "fieldname": "low_days",
      "fieldtype": "Int",
      "label": "Low From Days Overdue",
      "default": 1,
      "required": true
    },
    {
      "fieldname": "medium_days",
      "fieldtype": "Int",
      "label": "Medium From Days Overdue",
      "default": 7,
      "required": true
    },
    {
      "fieldname": "high_days",
      "fieldtype": "Int",
      "label": "High From Days Overdue",
      "default": 14,
      "required": true
    },
    {
      "fieldname": "critical_days",
      "fieldtype": "Int",
      "label": "Critical From Days Overdue",
      "default": 30,
      "required": true
    },
    {
      "fieldname": "risk_score_thresholds",
      "fieldtype": "Section Break",
      "label": "Risk Score Thresholds"
    },
    {
      "fieldname": "low_score",
      "fieldtype": "Int",
      "label": "Low From Score",
      "default": 0,
      "required": true
    },
    {
      "fieldname": "medium_score",
      "fieldtype": "Int",
      "label": "Medium From Score",
      "default": 40,
      "required": true
    },
    {
      "fieldname": "high_score",
      "fieldtype": "Int",
      "label": "High From Score",
      "default": 65,
      "required": true
    },
    {
      "fieldname": "critical_score",
      "fieldtype": "Int",
      "label": "Critical From Score",
      "default": 85,
      "required": true
    },
    {
