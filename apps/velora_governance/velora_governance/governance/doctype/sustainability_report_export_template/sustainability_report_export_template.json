{
 "name": "Sustainability Report Export Template",
 "module": "Governance",
 "autoname": "series:SRET-.####",
 "track_changes": true,
 "fields": [
  {
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "required": true,
   "in_list_view": true
  },
  {
   "fieldname": "template_type",
   "fieldtype": "Select",
   "label": "Template Type",
   "options": [
    "Board Report",
    "Management Report",
    "Regulatory Report",
    "Public Report",
    "Custom"
   ],
   "required": true,
   "default": "Board Report",
   "in_list_view": true
  },
  {
   "fieldname": "export_formats",
   "fieldtype": "Text",
   "label": "Export Formats",
   "options": [
    "PDF",
    "DOCX"
   ],
   "default": "PDF\nDOCX"
  },
  {
   "fieldname": "page_size",
   "fieldtype": "Select",
   "label": "Page Size",
   "options": [
    "A4",
    "Letter"
   ],
   "default": "A4"
  },
  {
   "fieldname": "orientation",
   "fieldtype": "Select",
   "label": "Orientation",
   "options": [
    "Portrait",
    "Landscape"
   ],
   "default": "Portrait"
  },
  {
   "fieldname": "cover_page",
   "fieldtype": "Check",
   "label": "Include Cover Page",
   "default": 1
  },
  {
   "fieldname": "header_text",
   "fieldtype": "Data",
   "label": "Header Text"
  },
  {
   "fieldname": "footer_text",
   "fieldtype": "Data",
   "label": "Footer Text"
  },
  {
   "fieldname": "page_numbers",
   "fieldtype": "Check",
   "label": "Include Page Numbers",
   "default": 1
  },
  {
   "fieldname": "margin_mm",
   "fieldtype": "Float",
   "label": "PDF Margin (mm)",
   "default": 18
  },
  {
   "fieldname": "margin_inches",
   "fieldtype": "Float",
   "label": "Word Margin (inches)",
   "default": 0.7
  },
  {
   "fieldname": "subtitle",
   "fieldtype": "Data",
   "label": "Cover Subtitle"
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": true
  },
  {
   "fieldname": "notes",
   "fieldtype": "Text",
   "label": "Template Notes"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": true,
   "export": true,
   "import": true,
   "report": true,
   "print": true,
   "email": true,
   "share": true
  },
  {
   "role": "Governance Administrator",
   "read": true,
   "write": true,
   "create": true,
   "delete": true,
   "export": true,
   "import": true,
   "report": true,
   "print": true,
   "email": true,
   "share": true
  },
  {
   "role": "Company Secretary",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "export": true,
   "import": true,
   "report": true,
   "print": true,
   "email": true,
   "share": true
  },
  {
   "role": "Governance Officer",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "export": true,
   "import": false,
   "report": true,
   "print": true,
   "email": false,
   "share": false
  },
  {
   "role": "Compliance Officer",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "export": true,
   "import": false,
   "report": true,
   "print": true
  },
  {
   "role": "Sustainability Officer",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "export": true,
   "import": false,
   "report": true,
   "print": true
  }
 ]
}