   "required": true
  },
  {
   "fieldname": "identifier",
   "fieldtype": "Data",
   "label": "Entity identifier",
   "required": true,
   "description": "For example the LEI, or the identifier your regulator requires."
  },
  {
   "fieldname": "co2e_unit_id",
   "fieldtype": "Data",
   "label": "Unit id",
