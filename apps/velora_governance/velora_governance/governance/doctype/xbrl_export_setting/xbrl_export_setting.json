  },
  {
   "fieldname": "co2e_unit_measure",
   "fieldtype": "Data",
   "label": "Unit measure (QName)",
   "required": true,
   "description": "The measure your taxonomy or the XBRL Unit Registry gives for tonnes of CO2 equivalent."
  },
  {
   "fieldname": "extra_namespaces",
   "fieldtype": "Text",
   "label": "Other namespace prefixes (one per line: prefix=uri)"
