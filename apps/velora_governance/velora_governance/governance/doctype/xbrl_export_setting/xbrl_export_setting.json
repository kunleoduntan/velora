   "options": "Governance Entity",
   "required": true,
   "unique": true,
   "in_list_view": true
  },
  {
   "fieldname": "schema_ref",
   "fieldtype": "Data",
   "label": "Taxonomy entry point (schemaRef URL)",
   "required": true,
   "description": "From the IFRS Sustainability Disclosure Taxonomy release you file against, or the regulator's filing manual. Not guessed by the system."
  },
