{
  "name": "General Ledger",
  "module": "Accounts",
  "type": "script",
  "ref_doctype": "GL Entry",
  "roles": [
    "System Manager",
    "Accounts Manager",
    "Accountant",
    "Accounts User"
  ],
  "description": "Every ledger entry with a running balance. Filter by account and/or customer/supplier for an account or a party statement.",
  "filters": [
    {
      "fieldname": "account",
      "label": "Account",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "party",
      "label": "Party (customer / supplier)",
      "fieldtype": "Data"
    },
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date",
      "default": "Year Start"
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date",
      "default": "Today"
    },
    {
      "fieldname": "show_cancelled",
      "label": "Show cancelled entries",
      "fieldtype": "Check"
    }
  ]
}
