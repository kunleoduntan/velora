{
  "name": "Supplier",
  "module": "Accounts",
  "autoname": "field:supplier_name",
  "track_changes": true,
  "fields": [
    {
      "fieldname": "supplier_name",
      "fieldtype": "Data",
      "label": "Supplier Name",
      "required": true,
      "unique": true,
      "in_list_view": true
    },
    {
      "fieldname": "tax_id",
      "fieldtype": "Data",
      "label": "Tax ID (TIN)",
      "in_list_view": true
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Phone"
    },
    {
      "fieldname": "address",
      "fieldtype": "Text",
      "label": "Address"
    },
    {
      "fieldname": "credit_days",
      "fieldtype": "Int",
      "label": "Payment Terms (days)",
      "default": 0,
      "description": "Due date = invoice date + this many days."
    },
    {
      "fieldname": "default_wht_rate",
      "fieldtype": "Float",
      "label": "Usual WHT %",
      "description": "For reference when paying this supplier."
    },
    {
      "fieldname": "bank_name",
      "fieldtype": "Data",
      "label": "Bank"
    },
    {
      "fieldname": "account_number",
      "fieldtype": "Data",
      "label": "Account Number"
    },
    {
      "fieldname": "account_name",
      "fieldtype": "Data",
      "label": "Account Name"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Active",
        "Blocked"
      ],
      "default": "Active",
      "in_list_view": true,
      "in_standard_filter": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "submit": true,
      "cancel": true,
      "export": true,
      "report": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accounts Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "submit": true,
      "cancel": true,
      "export": true,
      "report": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "report": true,
      "share": true,
      "import": true
    },
    {
      "role": "Accounts User",
      "read": true,
      "export": true,
      "report": true
    }
  ]
}