{
  "name": "Account",
  "module": "Accounts",
  "autoname": "field:account_name",
  "track_changes": true,
  "fields": [
    {
      "fieldname": "account_name",
      "fieldtype": "Data",
      "label": "Account Name",
      "required": true,
      "unique": true,
      "in_list_view": true
    },
    {
      "fieldname": "account_number",
      "fieldtype": "Data",
      "label": "Account Number",
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "parent_account",
      "fieldtype": "Link",
      "label": "Parent Account",
      "options": "Account",
      "in_standard_filter": true
    },
    {
      "fieldname": "is_group",
      "fieldtype": "Check",
      "label": "Is Group",
      "in_list_view": true
    },
    {
      "fieldname": "root_type",
      "fieldtype": "Select",
      "label": "Root Type",
      "options": [
        "Asset",
        "Liability",
        "Equity",
        "Income",
        "Expense"
      ],
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "account_type",
      "fieldtype": "Select",
      "label": "Account Type",
      "options": [
        "",
        "Bank",
        "Cash",
        "Receivable",
        "Payable",
        "Tax",
        "Retained Earnings",
        "Fixed Asset",
        "Accumulated Depreciation",
        "Stock",
        "Cost of Sales"
      ],
      "in_standard_filter": true
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled"
    },
    {
      "fieldname": "description",
      "fieldtype": "Data",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "submit": true,
      "cancel": true,
      "export": true
    },
    {
      "role": "Accounts Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true
    },
    {
      "role": "Accounts User",
      "read": true,
      "export": true
    }
  ]
}