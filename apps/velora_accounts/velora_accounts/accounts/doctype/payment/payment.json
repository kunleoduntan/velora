{
  "name": "Payment",
  "module": "Accounts",
  "autoname": "series:PAY-.#####",
  "is_submittable": true,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "payment_type",
      "fieldtype": "Select",
      "label": "Payment Type",
      "options": [
        "Vendor",
        "Other"
      ],
      "default": "Vendor",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "bank_account",
      "fieldtype": "Link",
      "label": "Cash / Bank Account",
      "options": "Account",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "method",
      "fieldtype": "Select",
      "label": "Method",
      "options": [
        "Cash",
        "Bank Transfer",
        "Cheque",
        "Card",
        "Gateway"
      ],
      "default": "Bank Transfer",
      "required": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "reference_no",
      "fieldtype": "Data",
      "label": "Reference No",
      "in_standard_filter": true
    },
    {
      "fieldname": "reference_date",
      "fieldtype": "Date",
      "label": "Reference Date"
    },
    {
      "fieldname": "party_type",
      "fieldtype": "Select",
      "label": "Party Type",
      "options": [
        "Supplier",
        "Employee"
      ],
      "default": "Supplier"
    },
    {
      "fieldname": "party",
      "fieldtype": "Data",
      "label": "Payee",
      "in_standard_filter": true
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Amount",
      "in_list_view": true
    },
    {
      "fieldname": "invoices",
      "fieldtype": "Table",
      "label": "Settle Invoices",
      "options": "Payment Invoice"
    },
    {
      "fieldname": "allocated_total",
      "fieldtype": "Currency",
      "label": "Settled",
      "read_only": true
    },
    {
      "fieldname": "discount_total",
      "fieldtype": "Currency",
      "label": "Discount",
      "read_only": true
    },
    {
      "fieldname": "on_account",
      "fieldtype": "Currency",
      "label": "On Account",
      "read_only": true,
      "description": "Money not applied to an invoice stays on the party's account as a credit."
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Payment Lines",
      "options": "Payment Line"
    },
    {
      "fieldname": "wht_rate",
      "fieldtype": "Float",
      "label": "WHT Rate %"
    },
    {
      "fieldname": "wht_amount",
      "fieldtype": "Currency",
      "label": "WHT Amount"
    },
    {
      "fieldname": "wht_account",
      "fieldtype": "Link",
      "label": "WHT Account",
      "options": "Account"
    },
    {
      "fieldname": "gateway",
      "fieldtype": "Data",
      "label": "Gateway"
    },
    {
      "fieldname": "gateway_reference",
      "fieldtype": "Data",
      "label": "Gateway Reference",
      "in_standard_filter": true
    },
    {
      "fieldname": "total",
      "fieldtype": "Currency",
      "label": "Total",
      "read_only": true
    },
    {
      "fieldname": "bank_amount",
      "fieldtype": "Currency",
      "label": "Paid From Bank",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Text",
      "label": "Remarks"
    },
    {
      "fieldname": "source_type",
      "fieldtype": "Data",
      "label": "Source Type",
      "read_only": true
    },
    {
      "fieldname": "source_ref",
      "fieldtype": "Data",
      "label": "Source",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "submit": true,
      "cancel": true,
      "export": true
    },
    {
      "role": "Accounts Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "submit": true,
      "cancel": true,
      "export": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true
    },
    {
      "role": "Accounts User",
      "read": true,
      "export": true
    }
  ]
}
