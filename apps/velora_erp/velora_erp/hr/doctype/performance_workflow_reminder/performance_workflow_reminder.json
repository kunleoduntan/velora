{
  "name": "Performance Workflow Reminder",
  "module": "HR",
  "track_changes": true,
  "description": "Auditable reminder work item for performance review milestones. Queueing does not itself send a notification.",
  "fields": [
    {
      "fieldname": "assignment",
      "fieldtype": "Link",
      "label": "Cycle Assignment",
      "options": "Performance Cycle Assignment",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "cycle",
      "fieldtype": "Link",
      "label": "Performance Cycle",
      "options": "Performance Cycle",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "required": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": true
    },
    {
      "fieldname": "recipient_user",
      "fieldtype": "Data",
      "label": "Recipient User",
      "required": true
    },
    {
      "fieldname": "reminder_type",
      "fieldtype": "Select",
      "label": "Reminder Type",
      "options": [
        "Self Review Due",
        "Manager Review Due",
        "Overdue"
      ],
      "required": true
    },
    {
      "fieldname": "due_date",
      "fieldtype": "Date",
      "label": "Due Date",
      "required": true
    },
    {
      "fieldname": "idempotency_key",
      "fieldtype": "Data",
      "label": "Idempotency Key",
      "required": true,
      "unique": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Queued",
        "Sent",
        "Failed",
        "Cancelled"
      ],
      "default": "Queued",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "queued_on",
      "fieldtype": "Datetime",
      "label": "Queued On"
    },
    {
      "fieldname": "sent_on",
      "fieldtype": "Datetime",
      "label": "Sent On"
    },
    {
      "fieldname": "delivery_error",
      "fieldtype": "Text",
      "label": "Delivery Error"
    }
  ],
  "permissions": [
    {
      "role": "HR Manager",
      "read": true,
      "create": true,
      "write": true,
      "report": true
    },
    {
      "role": "HR Officer",
      "read": true,
      "create": true,
      "report": true
    },
    {
      "role": "System Manager",
      "read": true,
      "create": true,
      "write": true,
      "report": true,
      "share": true,
      "import": true
    }
  ],
  "title_field": "employee_name"
}