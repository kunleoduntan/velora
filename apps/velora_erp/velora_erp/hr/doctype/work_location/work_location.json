{
  "name": "Work Location",
  "module": "HR",
  "track_changes": true,
  "description": "Physical, remote and operational work locations.",
  "fields": [
    {
      "fieldname": "location_code",
      "fieldtype": "Data",
      "label": "Location Code",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "length": 30
    },
    {
      "fieldname": "location_name",
      "fieldtype": "Data",
      "label": "Location Name",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "location_type",
      "fieldtype": "Select",
      "label": "Location Type",
      "options": [
        "Office",
        "Factory",
        "Branch",
        "Remote",
        "Client Site",
        "Other"
      ],
      "default": "Office"
    },
    {
      "fieldname": "address",
      "fieldtype": "Text",
      "label": "Address"
    },
    {
      "fieldname": "city",
      "fieldtype": "Data",
      "label": "City"
    },
    {
      "fieldname": "state_region",
      "fieldtype": "Data",
      "label": "State / Region"
    },
    {
      "fieldname": "country",
      "fieldtype": "Data",
      "label": "Country"
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled",
      "default": 0,
      "in_standard_filter": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "HR Officer",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true
    },
    {
      "role": "Department Manager",
      "read": true,
      "write": false,
      "create": false
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": false,
      "create": false
    },
    {
      "role": "Accountant",
      "read": true,
      "write": false,
      "create": false
    },
    {
      "role": "Auditor",
      "read": true,
      "write": false,
      "create": false
    }
  ],
  "autoname": "field:location_code",
  "title_field": "location_name"
}