      "in_list_view": true
    },
    {
      "fieldname": "start_datetime",
      "fieldtype": "Datetime",
      "label": "Start Date and Time",
      "required": true
    },
    {
      "fieldname": "end_datetime",
      "fieldtype": "Datetime",
      "label": "End Date and Time",
      "required": true
    },
    {
      "fieldname": "facilitator",
      "fieldtype": "Data",
      "label": "Facilitator"
    },
    {
      "fieldname": "venue",
      "fieldtype": "Data",
      "label": "Venue"
    },
    {
      "fieldname": "capacity",
      "fieldtype": "Int",
      "label": "Capacity"
    },
    {
      "fieldname": "session_status",
      "fieldtype": "Select",
      "label": "Status",
