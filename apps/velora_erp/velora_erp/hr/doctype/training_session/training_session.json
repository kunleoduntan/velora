{
  "name": "Training Session",
  "module": "HR",
  "track_changes": true,
  "description": "Scheduled delivery instance for an approved training programme.",
  "fields": [
    {
      "fieldname": "program",
      "fieldtype": "Link",
      "label": "Training Program",
      "options": "Training Program",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "session_title",
      "fieldtype": "Data",
      "label": "Session Title",
