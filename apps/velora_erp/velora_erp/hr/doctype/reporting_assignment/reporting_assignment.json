      "label": "Job Position",
      "options": "Job Position"
    },
    {
      "fieldname": "job_grade",
      "fieldtype": "Link",
      "label": "Job Grade",
      "options": "Job Grade"
    },
    {
      "fieldname": "job_band",
      "fieldtype": "Link",
      "label": "Job Band",
      "options": "Job Band"
    },
    {
      "fieldname": "work_location",
      "fieldtype": "Link",
      "label": "Work Location",
      "options": "Work Location"
    },
    {
