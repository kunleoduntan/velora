{
  "name": "Employee Status History",
  "module": "HR",
  "track_changes": true,
  "description": "Approved effective-dated employee status and lifecycle event history. Does not silently alter the canonical employee record.",
  "fields": [
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": true
    },
    {
      "fieldname": "event_type",
      "fieldtype": "Select",
      "label": "Lifecycle Event",
      "options": [
        "Hire",
        "Probation Started",
        "Confirmed",
        "Suspended",
        "Reinstated",
        "Seconded",
        "Retired",
        "Resigned",
        "Terminated",
        "Deceased",
        "Other"
      ],
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "effective_date",
      "fieldtype": "Date",
      "label": "Effective Date",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "previous_status",
      "fieldtype": "Data",
      "label": "Previous Status"
    },
    {
      "fieldname": "new_status",
      "fieldtype": "Data",
      "label": "New Status"
    },
    {
      "fieldname": "reason",
      "fieldtype": "Text",
      "label": "Reason",
      "required": true
    },
    {
      "fieldname": "reference_doctype",
      "fieldtype": "Data",
      "label": "Reference DocType"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Data",
      "label": "Reference Document"
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Draft",
        "Pending Approval",
        "Approved",
        "Rejected",
        "Cancelled"
      ],
      "default": "Draft",
      "required": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By"
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "HR Officer",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true,
      "report": true,
      "email": true
    }
  ],
  "title_field": "employee_name"
}