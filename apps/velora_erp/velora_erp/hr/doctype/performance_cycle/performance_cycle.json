{
  "name": "Performance Cycle",
  "module": "HR",
  "track_changes": true,
  "description": "Governed performance cycle with configurable milestones, assessment modes and calibration controls.",
  "fields": [
    {
      "fieldname": "cycle_code",
      "fieldtype": "Data",
      "label": "Cycle Code",
      "required": true,
      "unique": true,
      "in_list_view": true
    },
    {
      "fieldname": "cycle_name",
      "fieldtype": "Data",
      "label": "Cycle Name",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "cycle_type",
      "fieldtype": "Select",
      "label": "Cycle Type",
      "options": [
        "Annual",
        "Half Year",
        "Quarterly",
        "Probation",
        "Project Based",
        "Continuous",
        "Other"
      ],
      "default": "Annual",
      "required": true
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date",
      "required": true
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "End Date",
      "required": true
    },
    {
      "fieldname": "goal_setting_deadline",
      "fieldtype": "Date",
      "label": "Goal Setting Deadline"
    },
    {
      "fieldname": "self_review_deadline",
      "fieldtype": "Date",
      "label": "Self Review Deadline"
    },
    {
      "fieldname": "manager_review_deadline",
      "fieldtype": "Date",
      "label": "Manager Review Deadline"
    },
    {
      "fieldname": "review_template",
      "fieldtype": "Link",
      "label": "Review Template",
      "options": "Performance Review Template"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Draft",
        "Planning",
        "Active",
        "Review",
        "Calibration",
        "Completed",
        "Cancelled"
      ],
      "default": "Draft",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "include_self_assessment",
      "fieldtype": "Check",
      "label": "Include Self Assessment",
      "default": 1
    },
    {
      "fieldname": "include_peer_feedback",
      "fieldtype": "Check",
      "label": "Include Peer Feedback",
      "default": 0
    },
    {
      "fieldname": "include_360_feedback",
      "fieldtype": "Check",
      "label": "Include 360 Feedback",
      "default": 0
    },
    {
      "fieldname": "require_calibration",
      "fieldtype": "Check",
      "label": "Require Calibration",
      "default": 0
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "HR Officer",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true,
      "report": true,
      "email": true
    }
  ],
  "istable": false,
  "autoname": "field:cycle_code",
  "title_field": "cycle_name"
}