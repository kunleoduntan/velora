{
  "name": "Attendance",
  "module": "HR",
  "autoname": "hash",
  "track_changes": true,
  "description": "Daily employee attendance record with source, exception and approval controls.",
  "fields": [
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": true
    },
    {
      "fieldname": "attendance_date",
      "fieldtype": "Date",
      "label": "Attendance Date",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Attendance Status",
      "options": [
        "Present",
        "Absent",
        "Half Day",
        "On Leave",
        "Work From Home",
        "Holiday",
        "Weekly Off",
        "Outdoor Duty"
      ],
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "shift_assignment",
      "fieldtype": "Link",
      "label": "Shift Assignment",
      "options": "Shift Assignment"
    },
    {
      "fieldname": "check_in",
      "fieldtype": "Datetime",
      "label": "Check In"
    },
    {
      "fieldname": "check_out",
      "fieldtype": "Datetime",
      "label": "Check Out"
    },
    {
      "fieldname": "worked_hours",
      "fieldtype": "Float",
      "label": "Worked Hours",
      "read_only": true
    },
    {
      "fieldname": "late_minutes",
      "fieldtype": "Int",
      "label": "Late Minutes",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "early_exit_minutes",
      "fieldtype": "Int",
      "label": "Early Exit Minutes",
      "default": 0,
      "read_only": true
    },
    {
      "fieldname": "attendance_source",
      "fieldtype": "Select",
      "label": "Attendance Source",
      "options": [
        "Manual",
        "Device Import",
        "Mobile",
        "Web",
        "Integration"
      ],
      "default": "Manual"
    },
    {
      "fieldname": "device_reference",
      "fieldtype": "Data",
      "label": "Device Reference"
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Draft",
        "Pending Approval",
        "Approved",
        "Rejected"
      ],
      "default": "Draft",
      "required": true
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Text",
      "label": "Remarks"
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "print": true
    },
    {
      "role": "HR Officer",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true
    },
    {
      "role": "Department Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true
    },
    {
      "role": "Employee",
      "read": true,
      "write": false,
      "create": false,
      "delete": false,
      "export": false,
      "print": true
    }
  ],
  "title_field": "employee_name"
}