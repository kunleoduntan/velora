{
  "name": "Attendance Device User Mapping",
  "module": "HR",
  "autoname": "hash",
  "track_changes": true,
  "description": "Maps a provider or terminal user identifier to the canonical Velora Employee.",
  "fields": [
    {
      "fieldname": "mapping_key",
      "fieldtype": "Data",
      "label": "Mapping Key",
      "required": true,
      "unique": true,
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "integration",
      "fieldtype": "Link",
      "label": "Integration",
      "options": "Attendance Integration",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "device",
      "fieldtype": "Link",
      "label": "Device",
      "options": "Attendance Device",
      "in_list_view": true
    },
    {
      "fieldname": "external_user_id",
      "fieldtype": "Data",
      "label": "External User ID",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": true
    },
    {
      "fieldname": "effective_from",
      "fieldtype": "Date",
      "label": "Effective From"
    },
    {
      "fieldname": "effective_to",
      "fieldtype": "Date",
      "label": "Effective To"
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Active",
      "default": 1,
      "in_list_view": true
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "print": true
    },
    {
      "role": "HR Officer",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true
    },
    {
      "role": "Auditor",
      "read": true,
      "write": false,
      "create": false,
      "delete": false,
      "export": true,
      "print": true
    }
  ],
  "title_field": "employee_name"
}