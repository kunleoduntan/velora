{
  "name": "Overtime Register",
  "module": "HR",
  "type": "script",
  "ref_doctype": "Overtime Request",
  "roles": [
    "System Manager",
    "HR Manager",
    "Payroll Manager",
    "Finance Manager",
    "Auditor"
  ],
  "description": "Overtime hours by employee and type with approval and payroll-input status.",
  "filters": [
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "employee",
      "label": "Employee",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Link",
      "options": "Department"
    },
    {
      "fieldname": "branch",
      "label": "Branch",
      "fieldtype": "Link",
      "options": "Branch"
    },
    {
      "fieldname": "approval_status",
      "label": "Approval Status",
      "fieldtype": "Select",
      "options": [
        "Draft",
        "Pending Approval",
        "Approved",
        "Rejected",
        "Cancelled"
      ]
    }
  ]
}