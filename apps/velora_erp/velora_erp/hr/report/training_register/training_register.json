{
  "name": "Training Register",
  "module": "HR",
  "type": "script",
  "ref_doctype": "Training Enrollment",
  "roles": [
    "System Manager",
    "HR Manager",
    "HR User",
    "Auditor"
  ],
  "description": "Training enrolments, outcomes, cost and certificate validity per employee.",
  "filters": [
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "employee",
      "label": "Employee",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Link",
      "options": "Department"
    },
    {
      "fieldname": "branch",
      "label": "Branch",
      "fieldtype": "Link",
      "options": "Branch"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": [
        "Nominated",
        "Approved",
        "Waitlisted",
        "Enrolled",
        "Attended",
        "Absent",
        "Withdrawn",
        "Completed",
        "Failed"
      ]
    },
    {
      "fieldname": "expiring_only",
      "label": "Certificates Expiring / Expired Only",
      "fieldtype": "Check"
    }
  ]
}