{
  "name": "Fixed Asset Request",
  "module": "Finance",
  "track_changes": true,
  "description": "Capital expenditure request and approval gate. Does not create a financial posting.",
  "fields": [
    {
      "fieldname": "request_date",
      "fieldtype": "Date",
      "label": "Request Date",
      "required": true,
      "default": "Today"
    },
    {
      "fieldname": "requested_by",
      "fieldtype": "Data",
      "label": "Requested By"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "purpose",
      "fieldtype": "Text",
      "label": "Business Purpose",
      "required": true
    },
    {
      "fieldname": "required_by",
      "fieldtype": "Date",
      "label": "Required By"
    },
    {
      "fieldname": "lines_section",
      "fieldtype": "Section Break",
      "label": "Requested Assets",
      "collapsible": true
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Requested Assets",
      "options": "Fixed Asset Request Line",
      "required": true
    },
    {
      "fieldname": "estimated_total",
      "fieldtype": "Currency",
      "label": "Estimated Total",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval",
      "collapsible": true
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "converted_purchase",
      "fieldtype": "Data",
      "label": "Fixed Asset Purchase",
      "read_only": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Draft",
        "Approved",
        "Rejected",
        "Converted",
        "Closed",
        "Cancelled"
      ],
      "default": "Draft",
      "read_only": true,
      "in_list_view": true
    }
  ],
  "autoname": "series:FIX-.########",
  "is_submittable": true,
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "cancel": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}