{
  "name": "Fixed Asset Impairment",
  "module": "Finance",
  "track_changes": true,
  "description": "IAS 36 impairment loss and reversal assessment for owned and right-of-use assets.",
  "fields": [
    {
      "fieldname": "asset",
      "fieldtype": "Link",
      "label": "Fixed Asset",
      "options": "Fixed Asset",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "assessment_date",
      "fieldtype": "Date",
      "label": "Assessment Date",
      "required": true,
      "default": "Today"
    },
    {
      "fieldname": "action",
      "fieldtype": "Select",
      "label": "Assessment Action",
      "options": [
        "Recognise Impairment",
        "Reverse Impairment"
      ],
      "required": true,
      "default": "Recognise Impairment"
    },
    {
      "fieldname": "carrying_amount_before",
      "fieldtype": "Currency",
      "label": "Carrying Amount Before Assessment",
      "read_only": true
    },
    {
      "fieldname": "recoverable_amount",
      "fieldtype": "Currency",
      "label": "Recoverable Amount",
      "required": true
    },
    {
      "fieldname": "impairment_movement",
      "fieldtype": "Currency",
      "label": "Impairment Movement",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "accounting_section",
      "fieldtype": "Section Break",
      "label": "Accounting Treatment",
      "collapsible": true
    },
    {
      "fieldname": "revaluation_surplus_account",
      "fieldtype": "Link",
      "label": "Revaluation Surplus Account",
      "options": "Account",
      "depends_on": "eval:doc.action == \"Recognise Impairment\" || doc.action == \"Reverse Impairment\"",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "impairment_expense_account",
      "fieldtype": "Link",
      "label": "Impairment Loss Expense Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "impairment_account",
      "fieldtype": "Link",
      "label": "Accumulated Impairment Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "impairment_reversal_account",
      "fieldtype": "Link",
      "label": "Impairment Reversal Income Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "reason_section",
      "fieldtype": "Section Break",
      "label": "Assessment Evidence",
      "collapsible": true
    },
    {
      "fieldname": "impairment_indicators",
      "fieldtype": "Text",
      "label": "Impairment Indicators"
    },
    {
      "fieldname": "valuation_reference",
      "fieldtype": "Data",
      "label": "Valuation / Recoverable Amount Reference"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Text",
      "label": "Remarks"
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval and Posting",
      "collapsible": true
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "posting_batch",
      "fieldtype": "Data",
      "label": "Posting Batch",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "revaluation_surplus_movement",
      "fieldtype": "Currency",
      "label": "Revaluation Surplus Movement",
      "read_only": true
    },
    {
      "fieldname": "profit_or_loss_movement",
      "fieldtype": "Currency",
      "label": "Profit or Loss Movement",
      "read_only": true
    }
  ],
  "autoname": "series:FAI-.########",
  "is_submittable": true,
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "cancel": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}