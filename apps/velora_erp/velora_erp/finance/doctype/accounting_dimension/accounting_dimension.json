{
  "name": "Accounting Dimension",
  "module": "Finance",
  "track_changes": true,
  "description": "Configurable analytical dimension used to classify and report financial transactions across business processes.",
  "fields": [
    {
      "fieldname": "dimension_code",
      "fieldtype": "Data",
      "label": "Dimension Code",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "in_standard_filter": true,
      "length": 40
    },
    {
      "fieldname": "dimension_name",
      "fieldtype": "Data",
      "label": "Dimension Name",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "value_source",
      "fieldtype": "Select",
      "label": "Value Source",
      "options": [
        "Dimension Values",
        "Customer",
        "Supplier",
        "Employee",
        "Project",
        "Branch",
        "Department",
        "Item",
        "Warehouse",
        "Free Text",
        "Number",
        "Date"
      ],
      "required": true,
      "default": "Dimension Values"
    },
    {
      "fieldname": "mandatory_on_posting",
      "fieldtype": "Check",
      "label": "Mandatory on Posting"
    },
    {
      "fieldname": "applies_to_sales",
      "fieldtype": "Check",
      "label": "Apply to Sales"
    },
    {
      "fieldname": "applies_to_purchasing",
      "fieldtype": "Check",
      "label": "Apply to Purchasing"
    },
    {
      "fieldname": "applies_to_payments",
      "fieldtype": "Check",
      "label": "Apply to Payments"
    },
    {
      "fieldname": "applies_to_inventory",
      "fieldtype": "Check",
      "label": "Apply to Inventory"
    },
    {
      "fieldname": "applies_to_assets",
      "fieldtype": "Check",
      "label": "Apply to Fixed Assets"
    },
    {
      "fieldname": "applies_to_payroll",
      "fieldtype": "Check",
      "label": "Apply to Payroll"
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true
    }
  ],
  "autoname": "field:dimension_code",
  "title_field": "dimension_name"
}