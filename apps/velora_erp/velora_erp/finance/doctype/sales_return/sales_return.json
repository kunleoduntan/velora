{
  "name": "Sales Return",
  "module": "Finance",
  "autoname": "series:SR-.########",
  "is_submittable": true,
  "track_changes": true,
  "description": "Controlled sales return and credit reversal. Restock and quarantine dispositions are recorded; quarantine stock must use a dedicated quarantine warehouse.",
  "fields": [
    {
      "fieldname": "return_date",
      "label": "Return Date",
      "fieldtype": "Date",
      "required": true,
      "default": "Today",
      "in_list_view": true
    },
    {
      "fieldname": "posting_date",
      "label": "Posting Date",
      "fieldtype": "Date",
      "required": true,
      "default": "Today",
      "in_list_view": true
    },
    {
      "fieldname": "party",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "customer_name",
      "label": "Customer Name",
      "fieldtype": "Data",
      "fetch_from": "party.customer_name",
      "read_only": true
    },
    {
      "fieldname": "source_invoice",
      "label": "Original Sales Invoice",
      "fieldtype": "Link",
      "options": "Sales Invoice",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "currency",
      "label": "Transaction Currency",
      "fieldtype": "Link",
      "length": 3,
      "required": true,
      "options": "Currency"
    },
    {
      "fieldname": "exchange_rate",
      "label": "Exchange Rate",
      "fieldtype": "Float",
      "default": 1,
      "required": true
    },
    {
      "fieldname": "lines",
      "label": "Return Lines",
      "fieldtype": "Table",
      "options": "Sales Return Line",
      "required": true
    },
    {
      "fieldname": "net_amount",
      "label": "Net Return Amount",
      "fieldtype": "Currency",
      "read_only": true
    },
    {
      "fieldname": "tax_amount",
      "label": "Tax Reversal Amount",
      "fieldtype": "Currency",
      "read_only": true
    },
    {
      "fieldname": "grand_total",
      "label": "Total Return Amount",
      "fieldtype": "Currency",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_status",
      "label": "Approval Status",
      "fieldtype": "Select",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approved_by",
      "label": "Approved By",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "label": "Approved On",
      "fieldtype": "Datetime",
      "read_only": true
    },
    {
      "fieldname": "approval_comments",
      "label": "Approval Comments",
      "fieldtype": "Text"
    },
    {
      "fieldname": "narration",
      "label": "Reason / Narration",
      "fieldtype": "Text",
      "required": true
    },
    {
      "fieldname": "posting_batch",
      "label": "Financial Posting Batch",
      "fieldtype": "Link",
      "options": "Financial Posting Batch",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "warehouse",
      "label": "Return Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse",
      "required": false,
      "in_list_view": true
    },
    {
      "fieldname": "inventory_posting_batch",
      "label": "Inventory Posting Batch",
      "fieldtype": "Link",
      "options": "Financial Posting Batch",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "return_disposition",
      "label": "Return Disposition",
      "fieldtype": "Select",
      "options": [
        "Restock",
        "Quarantine"
      ],
      "default": "Restock",
      "required": true,
      "in_list_view": true,
      "description": "Quarantine returns must be received into a designated quarantine warehouse and must not be treated as saleable stock."
    },
    {
      "fieldname": "quality_inspection_required",
      "label": "Quality Inspection Required",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "inspection_reference",
      "label": "Inspection Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "quality_inspection_status",
      "label": "Quality Inspection Status",
      "fieldtype": "Select",
      "options": [
        "Pending",
        "Passed",
        "Failed"
      ],
      "default": "Pending",
      "required": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}