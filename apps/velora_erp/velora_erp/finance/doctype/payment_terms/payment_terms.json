{
  "name": "Payment Terms",
  "module": "Finance",
  "track_changes": true,
  "description": "Reusable invoice due-date and early-payment terms.",
  "autoname": "field:terms_code",
  "fields": [
    {
      "fieldname": "terms_code",
      "fieldtype": "Data",
      "label": "Terms Code",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "length": 30
    },
    {
      "fieldname": "terms_name",
      "fieldtype": "Data",
      "label": "Terms Name",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "due_days",
      "fieldtype": "Int",
      "label": "Invoice Due After (Days)",
      "default": 0,
      "required": true
    },
    {
      "fieldname": "discount_days",
      "fieldtype": "Int",
      "label": "Early Payment Discount Days",
      "default": 0
    },
    {
      "fieldname": "discount_percentage",
      "fieldtype": "Float",
      "label": "Early Payment Discount (%)",
      "default": 0
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Accountant",
      "read": true,
      "export": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true
    }
  ],
  "title_field": "terms_name"
}