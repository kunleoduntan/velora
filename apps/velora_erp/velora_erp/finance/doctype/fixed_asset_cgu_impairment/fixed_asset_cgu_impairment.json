{
  "name": "Fixed Asset CGU Impairment",
  "module": "Finance",
  "track_changes": true,
  "description": "Allocates CGU impairment first to goodwill and then pro rata to other eligible assets, subject to individual floors.",
  "fields": [
    {
      "fieldname": "cgu",
      "fieldtype": "Link",
      "label": "Cash-generating Unit",
      "options": "Fixed Asset CGU",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "assessment_date",
      "fieldtype": "Date",
      "label": "Assessment Date",
      "required": true
    },
    {
      "fieldname": "recoverable_amount",
      "fieldtype": "Currency",
      "label": "CGU Recoverable Amount",
      "required": true
    },
    {
      "fieldname": "carrying_amount_before",
      "fieldtype": "Currency",
      "label": "CGU Carrying Amount Before",
      "read_only": true
    },
    {
      "fieldname": "impairment_loss",
      "fieldtype": "Currency",
      "label": "CGU Impairment Loss",
      "read_only": true
    },
    {
      "fieldname": "revaluation_surplus_account",
      "fieldtype": "Link",
      "label": "Default Revaluation Surplus Account",
      "options": "Account",
      "description": "Fallback Equity account for revaluation reserve releases where an asset/category has no account default.",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "valuation_reference",
      "fieldtype": "Data",
      "label": "Valuation Reference",
      "required": true
    },
    {
      "fieldname": "lines_section",
      "fieldtype": "Section Break",
      "label": "Impairment Allocation",
      "collapsible": true
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Asset Allocation",
      "options": "Fixed Asset CGU Impairment Line"
    },
    {
      "fieldname": "other_asset_lines",
      "fieldtype": "Table",
      "label": "Goodwill and Other Asset Allocation",
      "options": "Fixed Asset CGU Other Asset Impairment Line"
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval and Posting",
      "collapsible": true
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
