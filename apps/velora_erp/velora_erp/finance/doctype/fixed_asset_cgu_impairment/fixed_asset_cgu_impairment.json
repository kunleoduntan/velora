      "default": "Pending",
      "required": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "posting_batch",
      "fieldtype": "Data",
      "label": "Posting Batch",
      "read_only": true,
      "hidden": true
    }
