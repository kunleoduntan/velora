   "amend": true
  },
  {
   "role": "Accountant",
   "read": true,
   "write": true,
   "create": true,
   "export": true,
   "print": true,
   "report": true,
   "email": true
  },
  {
   "role": "Auditor",
   "read": true,
   "export": true,
   "print": true,
   "report": true,
   "email": true
  }
 ]
}