{
 "name": "Foreign Currency Revaluation",
 "module": "Finance",
 "track_changes": true,
 "autoname": "series:FXR-.########",
 "is_submittable": true,
 "description": "Period-end revaluation of foreign-currency receivables, payables, bank balances and loans at the closing rate (IAS 21.23). Unrealised differences go to profit or loss and are reversed the next day.",
 "fields": [
  {
   "fieldname": "revaluation_date",
   "fieldtype": "Date",
   "label": "Revaluation Date",
   "required": true,
   "default": "Today",
   "in_list_view": true
  },
  {
   "fieldname": "narration",
   "fieldtype": "Text",
   "label": "Narration"
  },
  {
   "fieldname": "auto_reverse",
   "fieldtype": "Check",
   "label": "Reverse on the next day",
   "default": 1,
   "description": "Unrealised differences are reversed on the first day of the next period so the real gain or loss is recognised when the item is settled."
  },
  {
   "fieldname": "reversal_date",
   "fieldtype": "Date",
   "label": "Reversal Date"
  },
  {
   "fieldname": "lines_section",
   "fieldtype": "Section Break",
   "label": "Items revalued",
   "collapsible": true
  },
  {
   "fieldname": "lines",
   "fieldtype": "Table",
   "label": "Items revalued",
   "options": "Foreign Currency Revaluation Line",
   "read_only": 1
  },
  {
   "fieldname": "totals_section",
   "fieldtype": "Section Break",
   "label": "Effect"
  },
  {
   "fieldname": "total_gain",
   "fieldtype": "Currency",
   "label": "Unrealised gain",
   "read_only": 1
  },
  {
   "fieldname": "total_loss",
   "fieldtype": "Currency",
   "label": "Unrealised loss",
   "read_only": 1
  },
  {
   "fieldname": "net_effect",
   "fieldtype": "Currency",
   "label": "Net effect on profit",
   "read_only": 1
  },
  {
   "fieldname": "approval_section",
   "fieldtype": "Section Break",
   "label": "Approval",
   "collapsible": true
  },
  {
   "fieldname": "approval_status",
   "fieldtype": "Select",
   "label": "Approval Status",
   "options": [
    "Pending",
    "Approved",
    "Rejected"
   ],
   "default": "Pending",
   "required": true,
   "in_list_view": true
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Data",
   "label": "Approved By",
   "read_only": true
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved On",
   "read_only": true
  },
  {
   "fieldname": "posting_batch",
   "fieldtype": "Data",
   "label": "Posting Batch",
   "read_only": 1
  },
  {
   "fieldname": "reversal_batch",
   "fieldtype": "Data",
   "label": "Reversal Batch",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": [
    "Draft",
    "Posted",
    "Reversed",
    "Cancelled"
   ],
   "default": "Draft",
   "read_only": 1,
   "in_list_view": true
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": true,
   "write": true,
   "create": true,
   "submit": true,
   "cancel": true,
   "export": true,
   "print": true,
   "report": true,
   "email": true,
   "share": true,
   "import": true,
   "amend": true
  },
  {
   "role": "Finance Manager",
   "read": true,
