{
  "name": "Sales Invoice Line",
  "module": "Finance",
  "istable": true,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "item_code",
      "label": "Item Code",
      "fieldtype": "Link",
      "in_list_view": true,
      "options": "Inventory Item"
    },
    {
      "fieldname": "item_name",
      "fieldtype": "Data",
      "label": "Item Name",
      "read_only": true,
      "fetch_from": "item_code.item_name",
      "in_list_view": true
    },
    {
      "fieldname": "quantity",
      "label": "Invoiced Quantity",
      "fieldtype": "Float",
      "default": 0,
      "in_list_view": true
    },
    {
      "fieldname": "uom",
      "label": "Unit of Measure",
      "fieldtype": "Data",
      "fetch_from": "item_code.stock_uom"
    },
    {
      "fieldname": "account",
      "fieldtype": "Link",
      "label": "Income Account",
      "options": "Account",
      "required": true,
      "fetch_from": "item_code.income_account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "description",
      "fieldtype": "Data",
      "label": "Description",
      "required": true,
      "fetch_from": "item_code.item_name"
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Net Amount",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "base_rate",
      "fieldtype": "Currency",
      "label": "Rate (Base Currency)",
      "read_only": true
    },
    {
      "fieldname": "base_amount",
      "fieldtype": "Currency",
      "label": "Amount (Base Currency)",
      "read_only": true
    },
    {
      "fieldname": "tax_account",
      "fieldtype": "Link",
      "label": "Output VAT Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "tax_code",
      "fieldtype": "Data",
      "label": "Tax Code",
      "length": 60
    },
    {
      "fieldname": "tax_rate",
      "fieldtype": "Float",
      "label": "Tax Rate (%)",
      "default": 0
    },
    {
      "fieldname": "tax_amount",
      "fieldtype": "Currency",
      "label": "Tax Amount",
      "default": 0
    },
    {
      "fieldname": "cost_centre",
      "fieldtype": "Link",
      "label": "Cost Centre",
      "options": "Cost Centre",
      "fetch_from": "item_code.default_cost_centre"
    },
    {
      "fieldname": "batch",
      "label": "Batch",
      "fieldtype": "Link",
      "options": "Batch"
    },
    {
      "fieldname": "serial_number",
      "label": "Serial Number",
      "fieldtype": "Link",
      "options": "Serial Number"
    },
    {
      "fieldname": "valuation_rate",
      "label": "Inventory Valuation Rate",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "rate",
      "fieldtype": "Currency",
      "label": "Unit Selling Rate",
      "default": 0,
      "in_list_view": true
    },
    {
      "fieldname": "conversion_factor",
      "fieldtype": "Float",
      "label": "Stock UOM Conversion Factor",
      "default": 1
    },
    {
      "fieldname": "discount_percentage",
      "fieldtype": "Float",
      "label": "Discount Percentage (%)",
      "default": 0
    },
    {
      "fieldname": "discount_amount",
      "fieldtype": "Currency",
      "label": "Discount Amount per Unit",
      "default": 0
    },
    {
      "fieldname": "price_basis",
      "fieldtype": "Select",
      "label": "Price Basis",
      "options": [
        "Automatic",
        "Customer Group",
        "Item",
        "Default",
        "Manual"
      ],
      "default": "Automatic"
    },
    {
      "fieldname": "cost_rate",
      "fieldtype": "Currency",
      "label": "Cost Rate",
      "read_only": true
    },
    {
      "fieldname": "cost_source",
      "fieldtype": "Data",
      "label": "Cost Source",
      "read_only": true
    },
    {
      "fieldname": "price_note",
      "fieldtype": "Data",
      "label": "Price Applied",
      "read_only": true
    },
    {
      "fieldname": "group_price",
      "fieldtype": "Currency",
      "label": "Customer Group Price",
      "read_only": true
    },
    {
      "fieldname": "item_price",
      "fieldtype": "Currency",
      "label": "Item Price",
      "read_only": true
    },
    {
      "fieldname": "default_price",
      "fieldtype": "Currency",
      "label": "Default Price",
      "read_only": true
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Dispatch Warehouse",
      "options": "Warehouse",
      "in_list_view": true
    },
    {
      "fieldname": "source_line",
      "label": "Source Sales Order Line",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "source_doctype",
      "fieldtype": "Data",
      "label": "Source Type",
      "read_only": true,
      "description": "Filled when the line was pulled from another document."
    },
    {
      "fieldname": "source_document",
      "fieldtype": "Data",
      "label": "Source Document",
      "read_only": true
    }
  ],
  "permissions": []
}
