{
  "name": "Payroll Input",
  "module": "Finance",
  "track_changes": true,
  "description": "Approved one-time or recurring employee payroll input, available to mapped Salary Slip fields and salary component formulas.",
  "fields": [
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": true
    },
    {
      "fieldname": "salary_component",
      "fieldtype": "Link",
      "label": "Salary Component",
      "options": "Salary Component",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "input_fieldname",
      "fieldtype": "Data",
      "label": "Input Fieldname",
      "length": 64
    },
    {
      "fieldname": "input_value",
      "fieldtype": "Float",
      "label": "Input Value",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "effective_from",
      "fieldtype": "Date",
      "label": "Effective From",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "effective_to",
      "fieldtype": "Date",
      "label": "Effective To"
    },
    {
      "fieldname": "input_frequency",
      "fieldtype": "Select",
      "label": "Input Frequency",
      "options": [
        "One-time",
        "Ongoing"
      ],
      "default": "One-time",
      "required": true
    },
    {
      "fieldname": "input_mode",
      "fieldtype": "Select",
      "label": "Input Mode",
      "options": [
        "Replace",
        "Add"
      ],
      "default": "Replace",
      "required": true
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true
    },
    {
      "fieldname": "approval_hash",
      "fieldtype": "Data",
      "label": "Approval Fingerprint",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "processed_payroll_run",
      "fieldtype": "Link",
      "label": "Processed Payroll Run",
      "options": "Payroll Run",
      "read_only": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Draft",
        "Active",
        "Processed",
        "Rejected",
        "Cancelled"
      ],
      "default": "Draft",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Text",
      "label": "Remarks"
    }
  ],
  "is_submittable": true,
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "delete": false,
      "export": true,
      "cancel": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "delete": false,
      "export": true,
      "cancel": true
    },
    {
      "role": "Payroll Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": false,
      "delete": false
    },
    {
      "role": "Payroll Officer",
      "read": true,
      "write": true,
      "create": true,
      "submit": false,
      "delete": false
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "employee_name"
}
