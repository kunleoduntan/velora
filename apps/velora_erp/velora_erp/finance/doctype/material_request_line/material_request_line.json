{
  "name": "Material Request Line",
  "module": "Finance",
  "istable": true,
  "fields": [
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "label": "Item Code",
      "options": "Inventory Item",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "item_name",
      "fieldtype": "Data",
      "label": "Item Name",
      "fetch_from": "item_code.item_name",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "quantity",
      "fieldtype": "Float",
      "label": "Quantity",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "Uom",
      "options": "Unit of Measure",
      "fetch_from": "item_code.stock_uom"
    },
    {
      "fieldname": "warehouse",
      "fieldtype": "Link",
      "label": "Warehouse",
      "options": "Warehouse",
      "in_list_view": true
    },
    {
      "fieldname": "required_by",
      "fieldtype": "Date",
      "label": "Required By"
    },
    {
      "fieldname": "estimated_rate",
      "fieldtype": "Currency",
      "label": "Estimated Rate",
      "description": "Expected unit cost, used for budget and the estimated total."
    },
    {
      "fieldname": "fulfilled_quantity",
      "fieldtype": "Float",
      "label": "Fulfilled Quantity",
      "read_only": true,
      "description": "Quantity already converted to purchase orders, transfers or issues."
    },
    {
      "fieldname": "note",
      "fieldtype": "Data",
      "label": "Note"
    }
  ],
  "permissions": []
}
