{
  "name": "Opening Balance Entry",
  "module": "Finance",
  "autoname": "series:OBE-.########",
  "is_submittable": true,
  "track_changes": true,
  "description": "Controlled opening-balance migration document. Only balance-sheet accounts may be used; submission posts through the central Financial Posting Engine.",
  "fields": [
    {
      "fieldname": "opening_section",
      "fieldtype": "Section Break",
      "label": "Opening Balance Details"
    },
    {
      "fieldname": "opening_date",
      "fieldtype": "Date",
      "label": "Opening Balance Date",
      "required": true,
      "default": "Today",
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "migration_reference",
      "fieldtype": "Data",
      "label": "Migration Reference",
      "required": true,
      "unique": true,
      "length": 100
    },
    {
      "fieldname": "lines_section",
      "fieldtype": "Section Break",
      "label": "Opening Balances"
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Opening Balance Lines",
      "options": "Financial Voucher Line",
      "required": true
    },
    {
      "fieldname": "totals_section",
      "fieldtype": "Section Break",
      "label": "Control Totals"
    },
    {
      "fieldname": "total_debit",
      "fieldtype": "Currency",
      "label": "Total Debit",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "total_credit",
      "fieldtype": "Currency",
      "label": "Total Credit",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval"
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "rejected_by",
      "fieldtype": "Data",
      "label": "Rejected By",
      "read_only": true
    },
    {
      "fieldname": "rejected_on",
      "fieldtype": "Datetime",
      "label": "Rejected On",
      "read_only": true
    },
    {
      "fieldname": "approval_comments",
      "fieldtype": "Text",
      "label": "Approval Comments"
    },
    {
      "fieldname": "narration",
      "fieldtype": "Text",
      "label": "Migration Notes",
      "required": true
    },
    {
      "fieldname": "posting_batch",
      "fieldtype": "Link",
      "label": "Financial Posting Batch",
      "options": "Financial Posting Batch",
      "read_only": true,
      "hidden": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}