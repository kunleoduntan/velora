      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "label": "Subject",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "business_purpose",
