   "options": "Account",
   "required": true,
   "link_filters": [
    [
     "is_group",
     "=",
     0
    ]
   ]
  },
  {
   "fieldname": "allowance_account",
   "fieldtype": "Link",
   "label": "Loss allowance account (contra-receivable)",
   "options": "Account",
   "required": true,
   "link_filters": [
    [
     "is_group",
     "=",
     0
    ]
   ]
  },
  {
