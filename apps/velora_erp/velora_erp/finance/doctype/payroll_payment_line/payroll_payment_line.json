{
  "name": "Payroll Payment Line",
  "module": "Finance",
  "track_changes": true,
  "description": "Settlement line against an outstanding Salary Slip.",
  "fields": [
    {
      "fieldname": "salary_slip",
      "fieldtype": "Link",
      "label": "Salary Slip",
      "options": "Salary Slip",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "read_only": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": false
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Payment Amount",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "bank_account",
      "fieldtype": "Link",
      "label": "Bank / Cash Account",
      "options": "Account",
      "required": true,
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "reference",
      "fieldtype": "Data",
      "label": "Bank Reference"
    }
  ],
  "istable": true,
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true
    }
  ]
}
