{
  "name": "Sales Return Line",
  "module": "Finance",
  "istable": true,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "source_line",
      "label": "Original Invoice Line",
      "fieldtype": "Data",
      "required": true,
      "read_only": true
    },
    {
      "fieldname": "item_code",
      "label": "Item Code",
      "fieldtype": "Link",
      "options": "Inventory Item",
      "in_list_view": true
    },
    {
      "fieldname": "item_name",
      "fieldtype": "Data",
      "label": "Item Name",
      "read_only": true,
      "fetch_from": "item_code.item_name",
      "in_list_view": true
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Data",
      "required": true,
      "fetch_from": "item_code.item_name"
    },
    {
      "fieldname": "quantity",
      "label": "Returned Quantity",
      "fieldtype": "Float",
      "default": 0,
      "in_list_view": true
    },
    {
      "fieldname": "uom",
      "label": "Unit of Measure",
      "fieldtype": "Data",
      "fetch_from": "item_code.stock_uom"
    },
    {
      "fieldname": "account",
      "label": "Income Account",
      "fieldtype": "Link",
      "options": "Account",
      "required": true,
      "fetch_from": "item_code.income_account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "amount",
      "label": "Net Return Amount",
      "fieldtype": "Currency",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "tax_account",
      "label": "Original Tax Account",
      "fieldtype": "Link",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "tax_code",
      "label": "Tax Code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "tax_rate",
      "label": "Tax Rate (%)",
      "fieldtype": "Float",
      "default": 0
    },
    {
      "fieldname": "tax_amount",
      "label": "Tax Reversal Amount",
      "fieldtype": "Currency",
      "default": 0
    },
    {
      "fieldname": "cost_centre",
      "label": "Cost Centre",
      "fieldtype": "Link",
      "options": "Cost Centre",
      "fetch_from": "item_code.default_cost_centre"
    },
    {
      "fieldname": "batch",
      "label": "Batch",
      "fieldtype": "Link",
      "options": "Batch"
    },
    {
      "fieldname": "serial_number",
      "label": "Serial Number",
      "fieldtype": "Link",
      "options": "Serial Number"
    },
    {
      "fieldname": "valuation_rate",
      "label": "Valuation Rate",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "conversion_factor",
      "fieldtype": "Float",
      "label": "Stock UOM Conversion Factor",
      "default": 1,
      "read_only": true
    },
    {
      "fieldname": "condition_on_return",
      "label": "Condition on Return",
      "fieldtype": "Select",
      "options": [
        "New",
        "Good",
        "Damaged",
        "Defective",
        "Expired",
        "Incomplete",
        "Other"
      ]
    },
    {
      "fieldname": "inspection_notes",
      "label": "Inspection Notes",
      "fieldtype": "Text"
    }
  ],
  "permissions": []
}
