{
  "name": "Financial Year",
  "module": "Finance",
  "autoname": "field:year_name",
  "track_changes": true,
  "description": "A company's financial reporting year. Each company's financial years are maintained in its own database.",
  "fields": [
    {
      "fieldname": "year_name",
      "fieldtype": "Data",
      "label": "Financial Year",
      "required": true,
      "unique": true,
      "in_list_view": true
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "End Date",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Open",
        "Closing",
        "Closed"
      ],
      "default": "Open",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "is_current",
      "fieldtype": "Check",
      "label": "Current Financial Year",
      "default": 0,
      "in_list_view": true
    },
    {
      "fieldname": "closing_date",
      "fieldtype": "Date",
      "label": "Date Closed",
      "read_only": true
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "export": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true
    }
  ],
  "title_field": "year_name"
}