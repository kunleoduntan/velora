{
  "name": "Employee Loan Repayment",
  "module": "Finance",
  "track_changes": true,
  "description": "Repayment of employee loan principal and interest, including recovery through payroll.",
  "fields": [
    {
      "fieldname": "employee_loan",
      "fieldtype": "Link",
      "label": "Employee Loan",
      "options": "Employee Loan",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "required": true
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": true,
      "fetch_from": "employee.employee_name",
      "in_list_view": true
    },
    {
      "fieldname": "repayment_date",
      "fieldtype": "Date",
      "label": "Repayment Date",
      "required": true
    },
    {
      "fieldname": "principal_amount",
      "fieldtype": "Currency",
      "label": "Principal Repaid",
      "required": true
    },
    {
      "fieldname": "interest_amount",
      "fieldtype": "Currency",
      "label": "Interest Repaid",
      "default": 0
    },
    {
      "fieldname": "settlement_method",
      "fieldtype": "Select",
      "label": "Settlement Method",
      "options": [
        "Bank / Cash",
        "Payroll Deduction"
      ],
      "required": true
    },
    {
      "fieldname": "bank_account",
      "fieldtype": "Link",
      "label": "Bank / Cash Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "payroll_payable_account",
      "fieldtype": "Link",
      "label": "Payroll Payable Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "loan_account",
      "fieldtype": "Link",
      "label": "Loan Receivable Account",
      "options": "Account",
      "required": true,
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "interest_income_account",
      "fieldtype": "Link",
      "label": "Interest Income Account",
      "options": "Account",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "length": 3,
      "required": true,
      "options": "Currency"
    },
    {
      "fieldname": "posting_batch",
      "fieldtype": "Link",
      "label": "Financial Posting Batch",
      "options": "Financial Posting Batch",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_hash",
      "fieldtype": "Data",
      "label": "Approval Fingerprint",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Draft",
        "Posted",
        "Cancelled"
      ],
      "default": "Draft",
      "read_only": true
    }
  ],
  "is_submittable": true,
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
