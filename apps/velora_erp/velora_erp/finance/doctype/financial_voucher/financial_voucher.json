{
  "name": "Financial Voucher",
  "module": "Finance",
  "autoname": "series:FV-.########",
  "is_submittable": true,
  "track_changes": true,
  "description": "Controlled manual accounting adjustment. Submission creates an immutable Account Ledger posting through the central Financial Posting Engine.",
  "fields": [
    {
      "fieldname": "voucher_section",
      "fieldtype": "Section Break",
      "label": "Voucher Details"
    },
    {
      "fieldname": "voucher_date",
      "fieldtype": "Date",
      "label": "Voucher Date",
      "required": true,
      "default": "Today",
      "in_list_view": true
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Date",
      "label": "Posting Date",
      "required": true,
      "default": "Today",
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "purpose",
      "fieldtype": "Select",
      "label": "Adjustment Purpose",
      "options": [
        "General Adjustment",
        "Accrual",
        "Prepayment",
        "Reclassification",
        "Correction",
        "Other"
      ],
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "reference_number",
      "fieldtype": "Data",
      "label": "External Reference",
      "length": 100
    },
    {
      "fieldname": "currency_section",
      "fieldtype": "Section Break",
      "label": "Currency"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Transaction Currency",
      "length": 3,
      "required": true,
      "options": "Currency"
    },
    {
      "fieldname": "exchange_rate",
      "fieldtype": "Float",
      "label": "Exchange Rate to Base Currency",
      "default": 1,
      "required": true
    },
    {
      "fieldname": "lines_section",
      "fieldtype": "Section Break",
      "label": "Voucher Lines"
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Lines",
      "options": "Financial Voucher Line",
      "required": true
    },
    {
      "fieldname": "totals_section",
      "fieldtype": "Section Break",
      "label": "Control Totals"
    },
    {
      "fieldname": "total_debit",
      "fieldtype": "Currency",
      "label": "Total Debit",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "total_credit",
      "fieldtype": "Currency",
      "label": "Total Credit",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval"
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "rejected_by",
      "fieldtype": "Data",
      "label": "Rejected By",
      "read_only": true
    },
    {
      "fieldname": "rejected_on",
      "fieldtype": "Datetime",
      "label": "Rejected On",
      "read_only": true
    },
    {
      "fieldname": "approval_comments",
      "fieldtype": "Text",
      "label": "Approval Comments"
    },
    {
      "fieldname": "narration_section",
      "fieldtype": "Section Break",
      "label": "Narration"
    },
    {
      "fieldname": "narration",
      "fieldtype": "Text",
      "label": "Voucher Narration",
      "required": true
    },
    {
      "fieldname": "posting_batch",
      "fieldtype": "Link",
      "label": "Financial Posting Batch",
      "options": "Financial Posting Batch",
      "read_only": true,
      "hidden": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}