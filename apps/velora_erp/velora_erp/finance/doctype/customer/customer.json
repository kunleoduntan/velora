{
  "name": "Customer",
  "module": "Finance",
  "track_changes": true,
  "description": "Customer master and party-level receivables control account assignment.",
  "autoname": "field:customer_code",
  "fields": [
    {
      "fieldname": "customer_code",
      "fieldtype": "Data",
      "label": "Customer Code",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "in_standard_filter": true,
      "length": 40
    },
    {
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "label": "Customer Name",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "customer_group",
      "fieldtype": "Link",
      "label": "Customer Group",
      "options": "Customer Group",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "customer_type",
      "fieldtype": "Select",
      "label": "Customer Type",
      "options": [
        "Company",
        "Individual"
      ],
      "default": "Company",
      "required": true
    },
    {
      "fieldname": "tax_registration_number",
      "fieldtype": "Data",
      "label": "Tax Registration Number",
      "length": 60
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email Address"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Telephone"
    },
    {
      "fieldname": "billing_address",
      "fieldtype": "Text",
      "label": "Billing Address"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Default Transaction Currency",
      "length": 3,
      "description": "Optional default currency; blank uses company base currency.",
      "options": "Currency"
    },
    {
      "fieldname": "payment_terms",
      "fieldtype": "Link",
      "label": "Payment Terms",
      "options": "Payment Terms"
    },
    {
      "fieldname": "control_account",
      "fieldtype": "Link",
      "label": "Receivables Control Account",
      "options": "Account",
      "required": true,
      "in_list_view": true,
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "advance_account",
      "fieldtype": "Link",
      "label": "Customer Advance Account",
      "options": "Account",
      "description": "Optional party-tracked advance account used for customer or supplier advances.",
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "credit_limit",
      "fieldtype": "Currency",
      "label": "Credit Limit",
      "default": 0,
      "description": "Credit limit in company base currency. Zero means unlimited."
    },
    {
      "fieldname": "credit_hold",
      "fieldtype": "Check",
      "label": "Credit Hold",
      "default": 0,
      "in_list_view": true
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled",
      "default": 0,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Internal Notes"
    },
    {
      "fieldname": "credit_hold_reason",
      "label": "Credit Hold Reason",
      "fieldtype": "Text",
      "description": "Required when Credit Hold is enabled."
    },
    {
      "fieldname": "credit_review_date",
      "label": "Next Credit Review Date",
      "fieldtype": "Date"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true
    },
    {
      "role": "Accountant",
      "read": true,
      "export": true,
      "report": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "report": true
    }
  ],
  "title_field": "customer_name"
}