{
  "name": "Bank Transaction Coding Rule",
  "module": "Finance",
  "autoname": "series:BTCR-.########",
  "track_changes": true,
  "description": "Deterministic rule-based coding for imported bank statement lines. Rules only propose accounts; posting remains separately approved.",
  "fields": [
    {
      "fieldname": "priority",
      "fieldtype": "Int",
      "label": "Priority",
      "default": 100,
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "match_field",
      "fieldtype": "Select",
      "label": "Match Field",
      "options": [
        "Description",
        "Bank Reference"
      ],
      "required": true
    },
    {
      "fieldname": "match_operator",
      "fieldtype": "Select",
      "label": "Match Operator",
      "options": [
        "Contains",
        "Starts With",
        "Equals"
      ],
      "default": "Contains",
      "required": true
    },
    {
      "fieldname": "match_text",
      "fieldtype": "Data",
      "label": "Match Text",
      "required": true
    },
    {
      "fieldname": "direction",
      "fieldtype": "Select",
      "label": "Direction",
      "options": [
        "",
        "Receipt",
        "Payment"
      ]
    },
    {
      "fieldname": "offset_account",
      "fieldtype": "Link",
      "label": "Offset Account",
      "options": "Account",
      "required": true,
      "link_filters": [
        [
          "is_group",
          "=",
          0
        ],
        [
          "disabled",
          "=",
          0
        ]
      ]
    },
    {
      "fieldname": "party_type",
      "fieldtype": "Select",
      "label": "Party Type",
      "options": [
        "",
        "Customer",
        "Supplier",
        "Employee"
      ]
    },
    {
      "fieldname": "party",
      "fieldtype": "Data",
      "label": "Party"
    },
    {
      "fieldname": "cost_centre",
      "fieldtype": "Link",
      "label": "Cost Centre",
      "options": "Cost Centre"
    },
    {
      "fieldname": "business_unit",
      "fieldtype": "Link",
      "label": "Business Unit",
      "options": "Business Unit"
    },
    {
      "fieldname": "valid_from",
      "fieldtype": "Date",
      "label": "Valid From"
    },
    {
      "fieldname": "valid_to",
      "fieldtype": "Date",
      "label": "Valid To"
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled",
      "default": 0,
      "in_list_view": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "report": true,
      "share": true,
      "import": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": true,
      "report": true
    },
    {
      "role": "Accountant",
      "read": true,
      "export": true,
      "report": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "report": true
    }
  ]
}