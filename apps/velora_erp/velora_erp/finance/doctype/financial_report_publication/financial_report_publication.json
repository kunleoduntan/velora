{
  "name": "Financial Report Publication",
  "module": "Finance",
  "track_changes": true,
  "description": "Governed, independently approved and immutable publication snapshot of a financial report.",
  "autoname": "series:FRP-.########",
  "is_submittable": true,
  "fields": [
    {
      "fieldname": "report_section",
      "fieldtype": "Section Break",
      "label": "Report Definition"
    },
    {
      "fieldname": "report_layout",
      "fieldtype": "Data",
      "label": "Financial Report Layout ID",
      "required": true,
      "in_list_view": true,
      "description": "Select a saved financial report layout ID (FR-...)."
    },
    {
      "fieldname": "report_title",
      "fieldtype": "Data",
      "label": "Report Title",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "from_date",
      "fieldtype": "Date",
      "label": "From Date"
    },
    {
      "fieldname": "to_date",
      "fieldtype": "Date",
      "label": "To Date"
    },
    {
      "fieldname": "as_of_date",
      "fieldtype": "Date",
      "label": "As At Date"
    },
    {
      "fieldname": "budget_name",
      "fieldtype": "Data",
      "label": "Budget Name",
      "description": "Required when the selected report layout contains a Budget column."
    },
    {
      "fieldname": "dimension_section",
      "fieldtype": "Section Break",
      "label": "Reporting Dimensions",
      "collapsible": true
    },
    {
      "fieldname": "cost_centre",
      "fieldtype": "Link",
      "label": "Cost Centre",
      "options": "Cost Centre"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch"
    },
    {
      "fieldname": "business_unit",
      "fieldtype": "Link",
      "label": "Business Unit",
      "options": "Business Unit"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "Project"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "snapshot_section",
      "fieldtype": "Section Break",
      "label": "Generated Report Snapshot"
    },
    {
      "fieldname": "report_snapshot",
      "fieldtype": "Text",
      "label": "Immutable Report Snapshot (JSON)",
      "read_only": true
    },
    {
      "fieldname": "snapshot_hash",
      "fieldtype": "Data",
      "label": "Snapshot SHA-256",
      "read_only": true
    },
    {
      "fieldname": "generated_by",
      "fieldtype": "Data",
      "label": "Generated By",
      "read_only": true
    },
    {
      "fieldname": "generated_on",
      "fieldtype": "Datetime",
      "label": "Generated On",
      "read_only": true
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Independent Review and Approval",
      "collapsible": true
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "approval_hash",
      "fieldtype": "Data",
      "label": "Approval Fingerprint",
      "read_only": true,
      "hidden": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "rejected_by",
      "fieldtype": "Data",
      "label": "Rejected By",
      "read_only": true
    },
    {
      "fieldname": "rejected_on",
      "fieldtype": "Datetime",
      "label": "Rejected On",
      "read_only": true
    },
    {
      "fieldname": "review_notes",
      "fieldtype": "Text",
      "label": "Review Notes"
    },
    {
      "fieldname": "publication_status",
      "fieldtype": "Select",
      "label": "Publication Status",
      "options": [
        "Draft",
        "Approved",
        "Rejected",
        "Published",
        "Cancelled"
      ],
      "default": "Draft",
      "read_only": true,
      "in_list_view": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "delete": true,
      "export": true,
      "print": true,
      "cancel": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true
    }
  ],
  "title_field": "budget_name"
}
