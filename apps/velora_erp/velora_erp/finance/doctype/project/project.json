{
  "name": "Project",
  "module": "Finance",
  "autoname": "field:project_code",
  "track_changes": true,
  "fields": [
    {
      "fieldname": "project_code",
      "fieldtype": "Data",
      "label": "Project Code",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "length": 40
    },
    {
      "fieldname": "project_name",
      "fieldtype": "Data",
      "label": "Project Name",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": [
        "Planned",
        "Active",
        "On Hold",
        "Completed",
        "Cancelled"
      ],
      "default": "Planned",
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date"
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "End Date"
    },
    {
      "fieldname": "cost_centre",
      "fieldtype": "Link",
      "label": "Cost Centre",
      "options": "Cost Centre"
    },
    {
      "fieldname": "business_unit",
      "fieldtype": "Link",
      "label": "Business Unit",
      "options": "Business Unit"
    },
    {
      "fieldname": "budget_amount",
      "fieldtype": "Currency",
      "label": "Budget Amount"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled",
      "default": 0,
      "in_standard_filter": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "export": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "write": true,
      "create": true,
      "export": true
    },
    {
      "role": "Auditor",
      "read": true
    }
  ],
  "title_field": "project_name"
}