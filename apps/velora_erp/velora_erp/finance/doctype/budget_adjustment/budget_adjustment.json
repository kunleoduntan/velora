{
  "name": "Budget Adjustment",
  "module": "Finance",
  "autoname": "series:BA-.########",
  "is_submittable": true,
  "track_changes": true,
  "description": "Approved increase, decrease or transfer applied on top of an approved Financial Budget. The original budget is never edited; reports and budget control use budget + approved adjustments.",
  "fields": [
    {
      "fieldname": "financial_budget",
      "fieldtype": "Link",
      "label": "Financial Budget",
      "options": "Financial Budget",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "adjustment_type",
      "fieldtype": "Select",
      "label": "Adjustment Type",
      "options": [
        "Increase",
        "Decrease",
        "Transfer"
      ],
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "adjustment_date",
      "fieldtype": "Date",
      "label": "Adjustment Date",
      "required": true,
      "default": "Today",
      "in_list_view": true
    },
    {
      "fieldname": "reason",
      "fieldtype": "Text",
      "label": "Reason",
      "required": true
    },
    {
      "fieldname": "lines_section",
      "fieldtype": "Section Break",
      "label": "Adjustment Lines"
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Lines",
      "options": "Budget Adjustment Line"
    },
    {
      "fieldname": "net_change",
      "fieldtype": "Currency",
      "label": "Net Change",
      "read_only": true
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval"
    },
    {
      "fieldname": "approval_status",
      "fieldtype": "Select",
      "label": "Approval Status",
      "options": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    },
    {
      "fieldname": "rejected_by",
      "fieldtype": "Data",
      "label": "Rejected By",
      "read_only": true
    },
    {
      "fieldname": "rejected_on",
      "fieldtype": "Datetime",
      "label": "Rejected On",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "delete": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}