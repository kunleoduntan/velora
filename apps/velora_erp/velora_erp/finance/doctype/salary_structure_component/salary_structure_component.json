    {
      "fieldname": "reduces_taxable_income",
      "fieldtype": "Check",
      "label": "Reduces Taxable Income",
      "default": 0,
      "depends_on": "eval:doc.component_type == 'Deduction'",
      "description": "Statutory relief such as employee pension, NHF or NHIS: the amount is taken off taxable pay before PAYE. Sequence it before the Progressive Tax component."
    },
    {
      "fieldname": "hide_on_payslip",
      "fieldtype": "Check",
      "label": "Hide on Payslip",
      "default": 0,
      "description": "Keep the amount in the calculation and the ledger but do not show it to the employee on the payslip, e.g. employer pension expense and its liability."
    },
    {
      "fieldname": "account",
      "fieldtype": "Link",
      "label": "Account",
      "options": "Account",
