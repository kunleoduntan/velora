{
  "name": "Customer Group",
  "module": "Finance",
  "track_changes": true,
  "description": "Customer classification for reporting and credit policy.",
  "autoname": "field:group_code",
  "fields": [
    {
      "fieldname": "group_code",
      "fieldtype": "Data",
      "label": "Group Code",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "in_standard_filter": true,
      "length": 30
    },
    {
      "fieldname": "group_name",
      "fieldtype": "Data",
      "label": "Group Name",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "parent_group",
      "fieldtype": "Link",
      "label": "Parent Group",
      "options": "Customer Group",
      "in_standard_filter": true
    },
    {
      "fieldname": "is_group",
      "fieldtype": "Check",
      "label": "Can Contain Subgroups",
      "default": 1
    },
    {
      "fieldname": "disabled",
      "fieldtype": "Check",
      "label": "Disabled"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    },
    {
      "fieldname": "selling_margin_percent",
      "fieldtype": "Float",
      "label": "Selling Margin (%)",
      "default": 0,
      "description": "Margin inherited by customers in this group and child groups unless overridden by a nearer group.",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true
    },
    {
      "role": "Accountant",
      "read": true,
      "export": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true
    }
  ],
  "title_field": "group_name"
}