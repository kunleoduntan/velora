{
  "name": "Material Request",
  "module": "Finance",
  "autoname": "series:MR-.######",
  "track_changes": true,
  "description": "A request for stock: to buy it, to move it between warehouses or to issue it for use. Approval is by the GUI workflow.",
  "fields": [
    {
      "fieldname": "request_type",
      "fieldtype": "Select",
      "label": "Request Type",
      "options": [
        "Purchase",
        "Material Transfer",
        "Material Issue"
      ],
      "default": "Purchase",
      "required": true,
      "in_list_view": true,
      "in_standard_filter": true
    },
    {
      "fieldname": "request_date",
      "fieldtype": "Date",
      "label": "Request Date",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "required_by",
      "fieldtype": "Date",
      "label": "Required By",
      "in_list_view": true
    },
    {
      "fieldname": "requester",
      "fieldtype": "Link",
      "label": "Requester",
      "options": "Employee"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department",
      "in_standard_filter": true
    },
    {
      "fieldname": "cost_centre",
      "fieldtype": "Link",
      "label": "Cost Centre",
      "options": "Cost Centre"
    },
    {
      "fieldname": "source_warehouse",
      "fieldtype": "Link",
      "label": "Source Warehouse",
      "options": "Warehouse",
      "depends_on": "eval:doc.request_type!='Purchase'",
      "description": "Where the stock comes from (transfer or issue)."
    },
    {
      "fieldname": "target_warehouse",
      "fieldtype": "Link",
      "label": "Target Warehouse",
      "options": "Warehouse",
      "depends_on": "eval:doc.request_type!='Material Issue'",
      "description": "Where the stock is needed (purchase delivery or transfer)."
    },
    {
      "fieldname": "request_status",
      "fieldtype": "Select",
      "label": "Request Status",
      "options": [
        "Draft",
        "Pending Approval",
        "Approved",
        "Rejected",
        "Cancelled",
        "Closed"
      ],
      "default": "Draft",
      "in_list_view": true,
      "in_standard_filter": true,
      "description": "Controlled by the approval workflow once one is configured."
    },
    {
      "fieldname": "fulfilment_status",
      "fieldtype": "Select",
      "label": "Fulfilment Status",
      "options": [
        "Not Started",
        "Partially Fulfilled",
        "Fulfilled"
      ],
      "default": "Not Started",
      "read_only": true,
      "in_list_view": true
    },
    {
      "fieldname": "purpose",
      "fieldtype": "Text",
      "label": "Purpose"
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Lines",
      "options": "Material Request Line",
      "required": true
    },
    {
      "fieldname": "total_quantity",
      "fieldtype": "Float",
      "label": "Total Quantity",
      "read_only": true
    },
    {
      "fieldname": "estimated_total",
      "fieldtype": "Currency",
      "label": "Estimated Total",
      "read_only": true
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Data",
      "label": "Approved By",
      "read_only": true
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true,
      "share": true,
      "import": true
    },
    {
      "role": "Inventory Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true
    },
    {
      "role": "Finance Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true
    },
    {
      "role": "Storekeeper",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true
    },
    {
      "role": "Department Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true
    },
    {
      "role": "Accountant",
      "read": 1,
      "export": 1,
      "print": 1,
      "report": true,
      "email": true
    },
    {
      "role": "Employee",
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "export": false,
      "print": true,
      "report": true,
      "email": true
    }
  ]
}