{
  "name": "Quality Inspection Template",
  "module": "Finance",
  "track_changes": true,
  "autoname": "field:template_name",
  "title_field": "template_name",
  "description": "The checks an item is inspected against: measured ranges and pass/fail points.",
  "fields": [
    {
      "fieldname": "template_name",
      "fieldtype": "Data",
      "label": "Template",
      "required": true,
      "unique": true,
      "in_list_view": true,
      "length": 100
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "What it checks"
    },
    {
      "fieldname": "parameters",
      "fieldtype": "Table",
      "label": "Parameters",
      "options": "Quality Parameter Row",
      "required": true
    }
  ],
