{
  "name": "Waybill",
  "module": "Finance",
  "track_changes": true,
  "fields": [
    {
      "fieldname": "document_date",
      "label": "Waybill Date",
      "fieldtype": "Date",
      "required": true,
      "default": "Today",
      "in_list_view": true
    },
    {
      "fieldname": "party",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer",
      "required": true,
      "in_list_view": true
    },
    {
      "fieldname": "source_doctype",
      "label": "Source Document Type",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "source_document",
      "label": "Source Document",
      "fieldtype": "Data",
      "read_only": true
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "length": 3,
      "required": true,
      "default": "@base_currency",
      "options": "Currency"
    },
    {
      "fieldname": "exchange_rate",
      "label": "Exchange Rate",
      "fieldtype": "Float",
      "required": true,
      "default": 1
    },
    {
      "fieldname": "lines",
      "label": "Waybill Lines",
      "fieldtype": "Table",
      "options": "Waybill Line",
      "required": true
    },
    {
      "fieldname": "delivery_note",
      "label": "Delivery Note",
      "fieldtype": "Link",
      "options": "Delivery Note",
      "required": false
    },
    {
      "fieldname": "transporter",
      "label": "Transporter",
      "fieldtype": "Data"
    },
    {
      "fieldname": "vehicle_number",
      "label": "Vehicle Registration",
      "fieldtype": "Data"
    },
    {
      "fieldname": "driver_name",
      "label": "Driver Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "driver_phone",
      "label": "Driver Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "dispatch_date",
      "label": "Dispatch Date",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "destination",
      "label": "Destination",
      "fieldtype": "Text"
    },
    {
      "fieldname": "narration",
      "label": "Narration",
      "fieldtype": "Text"
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": [
        "Open",
        "Partially Processed",
        "Completed",
        "Closed"
      ],
      "default": "Open",
      "read_only": true,
      "in_list_view": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "export": true,
      "print": true,
      "cancel": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true,
      "amend": true
    },
    {
      "role": "Accountant",
      "read": true,
      "write": true,
      "create": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    },
    {
      "role": "Auditor",
      "read": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true
    }
  ],
  "is_submittable": true,
  "autoname": "series:WB-.########",
  "description": "Transport document generated from a Delivery Note. It does not create inventory or financial postings.",
  "title_field": "driver_name"
}