{
  "name": "Sales Margin Analysis",
  "module": "Finance",
  "type": "script",
  "ref_doctype": "Sales Invoice",
  "roles": [
    "System Manager",
    "Finance Manager",
    "Accountant",
    "Auditor"
  ],
  "description": "Sales margin uses actual Delivery Note issue valuation when delivered quantities cover the invoice line; otherwise it falls back to the invoice-time estimated cost snapshot.",
  "filters": [
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date",
      "required": true
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date",
      "required": true
    },
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer"
    },
    {
      "fieldname": "item_code",
      "label": "Inventory Item",
      "fieldtype": "Link",
      "options": "Inventory Item"
    }
  ]
}
