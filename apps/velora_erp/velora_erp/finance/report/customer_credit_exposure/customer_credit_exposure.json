      "options": "Customer"
    },
    {
      "fieldname": "only_over_limit",
      "label": "Only Over Limit",
      "fieldtype": "Check",
      "default": 0
    },
    {
      "fieldname": "include_open_orders",
      "label": "Include Open Sales Orders",
      "fieldtype": "Check",
      "default": 1
    }
  ]
}
