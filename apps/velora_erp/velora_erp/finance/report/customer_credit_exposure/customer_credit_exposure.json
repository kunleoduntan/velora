{
  "name": "Customer Credit Exposure",
  "module": "Finance",
  "type": "script",
  "ref_doctype": "Customer",
  "roles": [
    "System Manager",
    "Finance Manager",
    "Accountant",
    "Auditor"
  ],
  "description": "Customer receivables plus uninvoiced commitments from submitted Sales Orders. A zero credit limit is treated as unlimited.",
  "filters": [
    {
      "fieldname": "customer",
      "label": "Customer",
