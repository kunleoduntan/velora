{
  "name": "Customer Complaint Register",
  "module": "Finance",
  "type": "script",
  "ref_doctype": "Customer Complaint",
  "roles": [
    "System Manager",
    "Finance Manager",
    "Sales Manager",
    "Sales User",
    "Auditor"
  ],
  "description": "Register of customer complaints, severity, ownership, resolution status and linked commercial documents.",
  "filters": [
    {
      "fieldname": "customer",
      "label": "Customer",
      "fieldtype": "Link",
      "options": "Customer"
    },
    {
      "fieldname": "resolution_status",
      "label": "Resolution Status",
      "fieldtype": "Select",
      "options": [
        "Open",
        "Under Investigation",
        "Awaiting Customer",
        "Resolved",
        "Closed",
        "Rejected"
      ]
    },
    {
      "fieldname": "severity",
      "label": "Severity",
      "fieldtype": "Select",
      "options": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date"
    }
  ]
}
