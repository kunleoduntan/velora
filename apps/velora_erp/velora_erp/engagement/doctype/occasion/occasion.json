{
  "name": "Occasion",
  "module": "Engagement",
  "autoname": "field:occasion_name",
  "title_field": "occasion_name",
  "fields": [
    {
      "fieldname": "sb_o",
      "fieldtype": "Section Break",
      "label": "Occasion"
    },
    {
      "fieldname": "occasion_name",
      "fieldtype": "Data",
      "label": "Name",
      "required": true,
      "unique": true,
      "in_list_view": true
    },
    {
      "fieldname": "occasion_date",
      "fieldtype": "Date",
      "label": "Date",
      "required": true,
      "in_list_view": true,
      "description": "For a yearly occasion only the day and month matter. For a movable feast such as Eid or Easter, untick Repeats yearly and enter this year's date."
    },
    {
      "fieldname": "repeat_yearly",
      "fieldtype": "Check",
      "label": "Repeats yearly",
      "default": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": 1,
      "in_list_view": true
    },
    {
      "fieldname": "cb_o",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "to_customers",
      "fieldtype": "Check",
      "label": "Send to customers",
      "default": 1
    },
    {
      "fieldname": "to_suppliers",
      "fieldtype": "Check",
      "label": "Send to suppliers",
      "default": 1
    },
    {
      "fieldname": "to_employees",
      "fieldtype": "Check",
      "label": "Send to employees",
      "default": 1
    },
    {
      "fieldname": "template",
      "fieldtype": "Link",
      "label": "Template",
      "options": "Moment Template",
      "description": "Leave empty to use the standard Holiday template."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "export": true,
      "print": true,
      "report": true,
      "email": true,
      "share": true,
      "import": true
    },
    {
      "role": "Engagement Manager",
      "read": true,
      "write": true,
      "create": true,
      "report": true,
      "export": true,
      "print": true
    },
    {
      "role": "Sales Manager",
      "read": true,
      "report": true,
      "export": true
    },
    {
      "role": "HR Manager",
      "read": true,
      "report": true,
      "export": true
    },
    {
      "role": "Finance Manager",
      "read": true,
      "report": true,
      "export": true
    }
  ]
}