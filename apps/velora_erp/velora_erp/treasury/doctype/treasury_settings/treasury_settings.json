{
 "name": "Treasury Settings",
 "module": "Debt and Treasury",
 "autoname": "field:settings_name",
 "track_changes": true,
 "title_field": "settings_name",
 "description": "Warning thresholds and defaults for Treasury.",
 "permissions": [
  {
   "role": "System Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "report": true,
   "export": true,
   "print": true,
   "share": true
  },
  {
   "role": "Finance Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "report": true,
   "export": true,
   "print": true,
   "share": true
  },
  {
   "role": "Accountant",
   "read": true,
   "write": true,
   "create": true,
   "report": true,
   "export": true,
   "print": true
  },
  {
   "role": "Auditor",
   "read": true,
   "report": true,
   "export": true,
   "print": true
  }
 ],
 "fields": [
  {
   "fieldname": "settings_name",
   "fieldtype": "Data",
   "label": "Name",
   "required": true,
   "default": "Treasury Settings",
   "unique": true
  },
  {
   "fieldname": "repayment_warning_days",
   "fieldtype": "Int",
   "label": "Warn this many days before an instalment is due",
   "default": 7
  },
  {
   "fieldname": "expiry_warning_days",
   "fieldtype": "Int",
   "label": "Warn this many days before a facility's availability ends",
   "default": 90
  },
  {
   "fieldname": "utilisation_alert_percent",
   "fieldtype": "Float",
   "label": "Warn when utilisation passes (%)",
   "default": 85
  },
  {
   "fieldname": "lender_concentration_percent",
   "fieldtype": "Float",
   "label": "Warn when one lender holds more than (% of debt)",
   "default": 60
  },
  {
   "fieldname": "fx_shock_percent",
   "fieldtype": "Float",
   "label": "Currency shock used in the exposure report (%)",
   "default": 10
  },
  {
   "fieldname": "rate_shock_points",
   "fieldtype": "Float",
   "label": "Interest rate shock used in the sensitivity (percentage points)",
   "default": 1
  },
  {
   "fieldname": "forecast_weeks",
   "fieldtype": "Int",
   "label": "Weeks in the liquidity forecast",
   "default": 13
  },
  {
   "fieldname": "minimum_cash_buffer",
   "fieldtype": "Currency",
   "label": "Minimum cash buffer",
   "default": 0,
   "description": "The liquidity forecast flags any week where cash falls below this."
  },
  {
   "fieldname": "default_interest_wht_rule",
   "fieldtype": "Data",
   "label": "Default withholding tax rule on interest",
   "description": "Used when a facility does not name one and the lender is marked as subject to withholding tax."
  }
 ]
}