{
 "name": "Interest Accrual",
 "module": "Debt and Treasury",
 "autoname": "series:ACR-.######",
 "track_changes": true,
 "title_field": "title",
 "description": "Books the interest that has built up on each loan since it was last accrued: Dr interest expense, Cr accrued interest.",
 "is_submittable": true,
 "permissions": [
  {
   "role": "System Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "report": true,
   "export": true,
   "print": true,
   "share": true,
   "submit": true,
   "cancel": true,
   "amend": true
  },
  {
   "role": "Finance Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "report": true,
   "export": true,
   "print": true,
   "share": true,
   "submit": true,
   "cancel": true,
   "amend": true
  },
  {
   "role": "Accountant",
   "read": true,
   "write": true,
   "create": true,
   "report": true,
   "export": true,
   "print": true,
   "submit": true
  },
  {
   "role": "Auditor",
   "read": true,
   "report": true,
   "export": true,
   "print": true
  }
 ],
 "fields": [
  {
   "fieldname": "details",
   "fieldtype": "Section Break",
   "label": "Accrual"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "read_only": true,
   "hidden": true
  },
  {
   "fieldname": "accrual_date",
   "fieldtype": "Date",
   "label": "Accrue interest through",
   "required": true,
   "in_list_view": true,
   "description": "The last day to include, usually month end. It cannot be in the future."
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "required": true,
   "in_list_view": true
  },
  {
   "fieldname": "exchange_rate",
   "fieldtype": "Float",
   "label": "Exchange rate",
   "default": 1
  },
  {
   "fieldname": "facility",
   "fieldtype": "Link",
   "label": "Only this facility",
   "options": "Financing Facility",
   "description": "Leave blank for every active loan in this currency.",
   "link_filters": [
    [
     "docstatus",
     "=",
     1
    ]
   ]
  },
  {
   "fieldname": "lines_section",
   "fieldtype": "Section Break",
   "label": "Interest by loan (calculated)"
  },
  {
   "fieldname": "lines",
   "fieldtype": "Table",
   "label": "Lines",
   "options": "Interest Accrual Line"
  },
  {
   "fieldname": "total_interest",
   "fieldtype": "Currency",
   "label": "Total interest",
   "in_list_view": true,
   "read_only": true
  },
  {
   "fieldname": "narration",
   "fieldtype": "Text",
   "label": "Narration"
  },
  {
   "fieldname": "approval",
   "fieldtype": "Section Break",
   "label": "Approval"
  },
  {
   "fieldname": "approval_status",
   "fieldtype": "Select",
   "label": "Approval status",
   "options": [
    "Pending",
    "Approved",
    "Rejected"
   ],
   "required": true,
   "default": "Pending",
   "in_list_view": true,
   "in_standard_filter": true
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Data",
   "label": "Approved by",
   "read_only": true
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved on",
   "read_only": true
  },
  {
   "fieldname": "rejected_by",
   "fieldtype": "Data",
   "label": "Rejected by",
   "read_only": true
  },
  {
   "fieldname": "rejected_on",
   "fieldtype": "Datetime",
   "label": "Rejected on",
   "read_only": true
  },
  {
   "fieldname": "approval_comments",
   "fieldtype": "Text",
   "label": "Approval comments"
  },
  {
   "fieldname": "posting_batch",
   "fieldtype": "Link",
   "label": "Financial Posting Batch",
   "options": "Financial Posting Batch",
   "read_only": true,
   "hidden": true
  }
 ]
}