   "hidden": true
  },
  {
   "fieldname": "facility",
   "fieldtype": "Link",
   "label": "Facility",
   "options": "Financing Facility",
   "required": true,
   "in_list_view": true,
   "in_standard_filter": true,
   "link_filters": [
    [
     "docstatus",
     "=",
     1
    ]
   ]
  },
  {
   "fieldname": "effective_date",
   "fieldtype": "Date",
   "label": "Effective from",
   "required": true,
   "in_list_view": true
  },
  {
   "fieldname": "reason",
   "fieldtype": "Text",
   "label": "Reason / lender's notice",
   "required": true
  },
  {
   "fieldname": "changes",
   "fieldtype": "Section Break",
   "label": "What changes (leave blank to keep as it is)"
  },
  {
   "fieldname": "new_interest_rate",
   "fieldtype": "Float",
   "label": "New all-in interest rate (%)",
   "in_list_view": true
  },
  {
   "fieldname": "new_approved_limit",
   "fieldtype": "Currency",
   "label": "New approved limit",
   "in_list_view": true
  },
  {
   "fieldname": "new_expiry_date",
   "fieldtype": "Date",
   "label": "New availability end date",
   "in_list_view": true
  },
  {
   "fieldname": "before",
   "fieldtype": "Section Break",
   "label": "Before the amendment (recorded when submitted)"
  },
  {
   "fieldname": "old_interest_rate",
   "fieldtype": "Float",
   "label": "Previous rate (%)",
   "read_only": true
  },
  {
   "fieldname": "old_approved_limit",
   "fieldtype": "Currency",
   "label": "Previous limit",
   "read_only": true
  },
  {
   "fieldname": "old_expiry_date",
   "fieldtype": "Date",
   "label": "Previous end date",
   "read_only": true
  },
  {
   "fieldname": "approval",
   "fieldtype": "Section Break",
   "label": "Approval"
  },
  {
