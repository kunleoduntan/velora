{
 "name": "Facility Amendment",
 "module": "Debt and Treasury",
 "autoname": "series:FAM-.######",
 "track_changes": true,
 "title_field": "title",
 "description": "A change to a facility's rate, limit or end date. A new rate reprices the unpaid instalments of floating-rate loans from the effective date.",
 "is_submittable": true,
 "permissions": [
  {
   "role": "System Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "report": true,
   "export": true,
   "print": true,
   "share": true,
   "submit": true,
   "cancel": true,
   "amend": true
  },
  {
   "role": "Finance Manager",
   "read": true,
   "write": true,
   "create": true,
   "delete": false,
   "report": true,
   "export": true,
   "print": true,
   "share": true,
   "submit": true,
   "cancel": true,
   "amend": true
  },
  {
   "role": "Accountant",
   "read": true,
   "write": true,
   "create": true,
   "report": true,
   "export": true,
   "print": true,
   "submit": true
  },
  {
   "role": "Auditor",
   "read": true,
   "report": true,
   "export": true,
   "print": true
  }
 ],
 "fields": [
  {
   "fieldname": "details",
