  {
   "fieldname": "approved_by",
   "fieldtype": "Data",
   "label": "Approved by",
   "read_only": true
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved on",
   "read_only": true
  },
  {
   "fieldname": "rejected_by",
   "fieldtype": "Data",
   "label": "Rejected by",
   "read_only": true
  },
  {
   "fieldname": "rejected_on",
   "fieldtype": "Datetime",
   "label": "Rejected on",
   "read_only": true
  },
  {
   "fieldname": "approval_comments",
   "fieldtype": "Text",
   "label": "Approval comments"
  },
  {
   "fieldname": "posting_batch",
   "fieldtype": "Link",
   "label": "Financial Posting Batch",
   "options": "Financial Posting Batch",
   "read_only": true,
