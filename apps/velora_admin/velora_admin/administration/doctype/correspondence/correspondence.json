{
  "name": "Correspondence",
  "module": "Administration",
  "autoname": "series:CORR-.YYYY.-.####",
  "title_field": "subject",
  "is_submittable": false,
  "istable": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "CORR-.YYYY.-.#####",
      "required": true
    },
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Subject",
      "required": true
    },
    {
      "fieldname": "direction",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Direction",
      "options": "Incoming\nOutgoing",
      "required": true
    },
    {
      "fieldname": "column_break_top",
      "fieldtype": "Column Break"
    },
    {
      "default": "Letter",
      "fieldname": "correspondence_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Type",
      "options": "Letter\nEmail\nMemo\nNotice\nCircular\nCourier\nOther"
    },
    {
      "default": "Registered",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Status",
      "options": "Registered\nAssigned\nAction Required\nResponded\nClosed"
    },
    {
      "default": "Medium",
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "Priority",
      "options": "Low\nMedium\nHigh"
    },
    {
      "fieldname": "section_break_parties",
      "fieldtype": "Section Break",
      "label": "Parties"
    },
    {
      "description": "Sender (for Incoming) or Recipient (for Outgoing)",
      "fieldname": "from_party",
      "fieldtype": "Data",
      "label": "From"
    },
    {
      "fieldname": "to_party",
      "fieldtype": "Data",
      "label": "To"
    },
    {
      "fieldname": "column_break_parties",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "reference_no",
      "fieldtype": "Data",
      "label": "Reference No."
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "section_break_handling",
      "fieldtype": "Section Break",
      "label": "Handling"
    },
    {
      "fieldname": "handled_by",
      "fieldtype": "Link",
      "label": "Handled By",
      "options": "Person"
    },
    {
      "default": "Today",
      "fieldname": "date",
      "fieldtype": "Date",
      "label": "Date",
      "required": true
    },
    {
      "fieldname": "column_break_handling",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "response_due_date",
      "fieldtype": "Date",
      "label": "Response Due Date"
    },
    {
      "fieldname": "linked_document",
      "fieldtype": "Link",
      "label": "Linked Document",
      "options": "Document Register"
    },
    {
      "fieldname": "section_break_attach",
      "fieldtype": "Section Break",
      "label": "Attachment & Notes"
    },
    {
      "fieldname": "attachment",
      "fieldtype": "Data",
      "label": "Attachment"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "share": true,
      "print": true,
      "email": true
    },
    {
      "role": "All",
      "read": true,
      "write": true,
      "create": true,
      "share": true,
      "print": true,
      "email": true
    }
  ]
}
