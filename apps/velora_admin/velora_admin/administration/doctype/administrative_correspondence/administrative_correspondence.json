{
  "name": "Administrative Correspondence",
  "module": "Administration",
  "autoname": "field:title",
  "istable": false,
  "is_submittable": false,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Subject",
      "fieldtype": "Data",
      "required": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "direction",
      "label": "Direction",
      "fieldtype": "Select",
      "options": "Incoming\nOutgoing\nInternal",
      "required": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reference_number",
      "label": "Reference Number",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "sender",
      "label": "Sender",
      "fieldtype": "Data"
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Data"
    },
    {
      "fieldname": "received_date",
      "label": "Received Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "sent_date",
      "label": "Sent Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "channel",
      "label": "Channel",
      "fieldtype": "Select",
      "options": "Email\nCourier\nHand Delivery\nPortal\nOther"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Received\nRegistered\nAssigned\nDraft Response\nAwaiting Approval\nSent\nClosed",
      "default": "Received",
      "in_list_view": 1
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Data"
    },
    {
      "fieldname": "response_due",
      "label": "Response Due",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "document_reference",
      "label": "Document Reference",
      "fieldtype": "Data"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1
    }
  ]
}
