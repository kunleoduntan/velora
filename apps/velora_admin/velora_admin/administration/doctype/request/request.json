{
  "name": "Request",
  "module": "Administration",
  "autoname": "series:AREQ-.YYYY.-.####",
  "title_field": "request_type",
  "is_submittable": true,
  "istable": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "AREQ-.YYYY.-.#####",
      "required": true
    },
    {
      "fieldname": "request_type",
      "fieldtype": "Link",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Request Type",
      "options": "Request Type",
      "required": true
    },
    {
      "default": "__user",
      "fieldname": "requester",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Requester",
      "options": "Person",
      "required": true
    },
    {
      "fieldname": "column_break_top",
      "fieldtype": "Column Break"
    },
    {
      "default": "Medium",
      "fieldname": "priority",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Priority",
      "options": "Low\nMedium\nHigh\nUrgent"
    },
    {
      "default": "Draft",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Status",
      "options": "Draft\nPending Approval\nApproved\nRejected\nIn Progress\nCompleted\nCancelled",
      "read_only": 1
    },
    {
      "fieldname": "section_break_org",
      "fieldtype": "Section Break",
      "label": "Organisation"
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "organisation_unit",
      "fieldtype": "Link",
      "label": "Organisation Unit",
      "options": "Organisation Unit"
    },
    {
      "fieldname": "location",
      "fieldtype": "Link",
      "label": "Location",
      "options": "Office Location"
    },
    {
      "fieldname": "column_break_org",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "required_by_date",
      "fieldtype": "Date",
      "label": "Required By"
    },
    {
      "fieldname": "section_break_desc",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text",
      "label": "Description"
    },
    {
      "fieldname": "section_break_cost",
      "fieldtype": "Section Break",
      "label": "Cost & Routing"
    },
    {
      "fieldname": "estimated_cost",
      "fieldtype": "Currency",
      "label": "Estimated Cost"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency"
    },
    {
      "fieldname": "column_break_cost",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "approval_matrix",
      "fieldtype": "Link",
      "label": "Approval Matrix",
      "options": "Approval Matrix"
    },
    {
      "default": "0",
      "fieldname": "current_level",
      "fieldtype": "Int",
      "label": "Current Approval Level",
      "read_only": 1
    },
    {
      "fieldname": "section_break_sla",
      "fieldtype": "Section Break",
      "label": "SLA"
    },
    {
      "fieldname": "sla_due_datetime",
      "fieldtype": "Datetime",
      "label": "SLA Due",
      "read_only": 1
    },
    {
      "default": "On Track",
      "fieldname": "sla_status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "SLA Status",
      "options": "On Track\nDue Soon\nOverdue",
      "read_only": 1
    },
    {
      "fieldname": "column_break_sla",
      "fieldtype": "Column Break"
    },
    {
      "default": "0",
      "fieldname": "escalated",
      "fieldtype": "Check",
      "label": "Escalated",
      "read_only": 1
    },
    {
      "fieldname": "escalated_on",
      "fieldtype": "Datetime",
      "label": "Escalated On",
      "read_only": 1
    },
    {
      "fieldname": "section_break_approvals",
      "fieldtype": "Section Break",
      "label": "Approval Chain"
    },
    {
      "fieldname": "approval_history",
      "fieldtype": "Table",
      "label": "Approval History",
      "options": "Request Approval",
      "read_only": 1
    },
    {
      "fieldname": "section_break_fulfilment",
      "fieldtype": "Section Break",
      "label": "Fulfilment"
    },
    {
      "fieldname": "fulfilment_status",
      "fieldtype": "Select",
      "label": "Fulfilment Status",
      "options": "Not Created\nUnassigned\nAssigned\nIn Progress\nBlocked\nCompleted\nCancelled",
      "read_only": 1,
      "default": "Not Created"
    },
    {
      "fieldname": "column_break_fulfilment",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "fulfilment_owner",
      "fieldtype": "Data",
      "label": "Fulfilment Owner",
      "read_only": 1
    },
    {
      "fieldname": "fulfilment_due_date",
      "fieldtype": "Date",
      "label": "Fulfilment Due Date",
      "read_only": 1
    },
    {
      "fieldname": "service",
      "fieldtype": "Link",
      "label": "Service",
      "options": "Service"
    },
    {
      "fieldname": "sla_warning_sent",
      "fieldtype": "Check",
      "label": "SLA Warning Sent",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "request_comments",
      "fieldtype": "Table",
      "label": "Request Comments",
      "options": "Request Comment"
    },
    {
      "fieldname": "sla_paused",
      "fieldtype": "Check",
      "label": "SLA Paused",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "sla_paused_on",
      "fieldtype": "Datetime",
      "label": "SLA Paused On",
      "read_only": 1
    },
    {
      "fieldname": "sla_pause_duration_hours",
      "fieldtype": "Float",
      "label": "Accumulated SLA Pause Hours",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "fulfilment_sla_due_datetime",
      "fieldtype": "Datetime",
      "label": "Fulfilment SLA Due",
      "read_only": 1
    },
    {
      "fieldname": "service_form_data",
      "fieldtype": "Text",
      "label": "Service Form Data"
    },
    {
      "fieldname": "reopened_count",
      "fieldtype": "Int",
      "label": "Reopened Count",
      "default": 0
    },
    {
      "fieldname": "last_reopened_on",
      "fieldtype": "Datetime",
      "label": "Last Reopened On"
    },
    {
      "fieldname": "reopening_reason",
      "fieldtype": "Text",
      "label": "Last Reopening Reason"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "submit": true,
      "cancel": true,
      "amend": true,
      "report": true,
      "export": true,
      "share": true,
      "print": true,
      "email": true
    },
    {
      "role": "All",
      "read": true,
      "write": true,
      "create": true,
      "submit": true,
      "share": true,
      "print": true,
      "email": true
    }
  ]
}
