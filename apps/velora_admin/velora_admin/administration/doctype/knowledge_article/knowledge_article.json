{
  "name": "Knowledge Article",
  "module": "Administration",
  "autoname": "field:title",
  "istable": false,
  "is_submittable": false,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Article Title",
      "fieldtype": "Data",
      "required": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "service",
      "label": "Service",
      "fieldtype": "Link",
      "options": "Service"
    },
    {
      "fieldname": "audience",
      "label": "Audience",
      "fieldtype": "Select",
      "options": "All Staff\nAdministration Staff\nManagers\nSpecific Role",
      "default": "All Staff"
    },
    {
      "fieldname": "content",
      "label": "Content",
      "fieldtype": "Text",
      "required": 1
    },
    {
      "fieldname": "keywords",
      "label": "Keywords",
      "fieldtype": "Data"
    },
    {
      "fieldname": "published",
      "label": "Published",
      "fieldtype": "Check",
      "default": 0,
      "in_list_view": 1
    },
    {
      "fieldname": "review_date",
      "label": "Review Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "article_owner",
      "label": "Article Owner",
      "fieldtype": "Data"
    },
    {
      "fieldname": "version",
      "label": "Version",
      "fieldtype": "Data",
      "default": "1.0"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1
    }
  ]
}
