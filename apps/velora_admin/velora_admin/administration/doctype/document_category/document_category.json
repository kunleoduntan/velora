{
  "name": "Document Category",
  "module": "Administration",
  "autoname": "field:category_name",
  "is_submittable": false,
  "istable": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "category_name",
      "fieldtype": "Data",
