    },
    {
      "default": "0",
      "fieldname": "requires_expiry",
      "fieldtype": "Check",
      "label": "Requires Expiry Date"
    },
    {
      "default": "0",
      "fieldname": "requires_review",
      "fieldtype": "Check",
      "label": "Requires Periodic Review"
    },
    {
      "fieldname": "default_review_frequency_days",
      "fieldtype": "Int",
      "label": "Default Review Frequency (Days)"
    },
    {
      "fieldname": "section_break_desc",
