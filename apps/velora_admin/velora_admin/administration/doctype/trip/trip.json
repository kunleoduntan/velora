      "label": "Requester",
      "fieldtype": "Link",
      "options": "Employee",
      "in_list_view": 1
    },
    {
      "fieldname": "purpose",
      "label": "Purpose",
      "fieldtype": "Text",
      "required": 1
    },
    {
      "fieldname": "origin",
      "label": "Origin",
      "fieldtype": "Data"
    },
    {
      "fieldname": "destination",
      "label": "Destination",
      "fieldtype": "Data",
      "required": 1
    },
    {
      "fieldname": "departure_datetime",
      "label": "Departure",
      "fieldtype": "Datetime",
      "in_list_view": 1
    },
    {
      "fieldname": "return_datetime",
      "label": "Return",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "vehicle",
      "label": "Vehicle",
      "fieldtype": "Link",
      "options": "Administrative Vehicle"
    },
    {
      "fieldname": "driver",
      "label": "Driver",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "passengers_json",
      "label": "Passengers JSON",
      "fieldtype": "Text",
      "options": "JSON"
    },
    {
