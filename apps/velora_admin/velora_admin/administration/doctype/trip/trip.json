      "default": "Requested",
      "in_list_view": 1
    },
    {
      "fieldname": "estimated_cost",
      "label": "Estimated Cost",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "actual_cost",
      "label": "Actual Cost",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Text"
    }
