{
  "name": "Task",
  "module": "Administration",
  "autoname": "field:title",
  "istable": false,
  "is_submittable": false,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Task Title",
      "fieldtype": "Data",
      "required": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "task_type",
      "label": "Task Type",
      "fieldtype": "Select",
      "options": "Routine\nAd Hoc\nService Request\nMaintenance\nInspection\nEvent\nTravel\nLogistics\nCompliance",
      "default": "Routine",
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Text"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Open\nIn Progress\nWaiting\nCompleted\nCancelled",
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "default": "Normal",
      "in_list_view": 1
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Data"
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Data"
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "recurrence",
      "label": "Recurrence",
      "fieldtype": "Select",
      "options": "None\nDaily\nWeekly\nMonthly\nQuarterly\nAnnually",
      "default": "None"
    },
    {
      "fieldname": "source_doctype",
      "label": "Source DocType",
      "fieldtype": "Data"
    },
    {
      "fieldname": "source_name",
      "label": "Source Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "checklist_json",
      "label": "Checklist JSON",
      "fieldtype": "Text",
      "options": "JSON"
    },
    {
      "fieldname": "completed_on",
      "label": "Completed On",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "completion_notes",
      "label": "Completion Notes",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1
    }
  ]
}
