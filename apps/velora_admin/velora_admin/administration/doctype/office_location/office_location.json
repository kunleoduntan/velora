{
  "name": "Office Location",
  "module": "Administration",
  "autoname": "field:location_name",
  "is_submittable": false,
  "istable": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "location_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Location Name",
      "unique": 1,
      "required": true
    },
    {
      "default": "Branch",
      "fieldname": "location_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Location Type",
      "options": "Head Office\nBranch\nSite\nWarehouse\nDepot\nRemote",
      "required": true
    },
    {
      "fieldname": "organisation_unit",
      "fieldtype": "Link",
      "label": "Organisation Unit",
      "options": "Organisation Unit"
    },
    {
      "fieldname": "column_break_loc",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "region",
      "fieldtype": "Data",
      "label": "Region / State"
    },
    {
      "fieldname": "country",
      "fieldtype": "Data",
      "label": "Country"
    },
    {
      "default": "1",
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Is Active"
    },
    {
      "fieldname": "section_break_addr",
      "fieldtype": "Section Break",
      "label": "Address & Contact"
    },
    {
      "fieldname": "address",
      "fieldtype": "Data",
      "label": "Address"
    },
    {
      "fieldname": "column_break_addr",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Data",
      "label": "Contact Person"
    },
    {
      "fieldname": "contact_phone",
      "fieldtype": "Data",
      "label": "Contact Phone"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "share": true,
      "print": true,
      "email": true
    },
    {
      "role": "All",
      "read": true
    }
  ]
}
