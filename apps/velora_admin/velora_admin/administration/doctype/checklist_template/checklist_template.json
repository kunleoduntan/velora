{
  "name": "Checklist Template",
  "module": "Administration",
  "autoname": "field:template_name",
  "is_submittable": false,
  "istable": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "template_name",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Template Name",
      "unique": 1,
      "required": true
    },
    {
      "fieldname": "checklist_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Checklist Type",
      "options": "Onboarding\nOffboarding",
      "required": true
    },
    {
      "default": "1",
      "fieldname": "is_active",
      "fieldtype": "Check",
      "in_list_view": 1,
      "label": "Is Active"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "description": "Leave blank to apply to every Person Type",
      "fieldname": "applicable_person_type",
      "fieldtype": "Select",
      "label": "Applicable Person Type",
      "options": "Employee\nConsultant\nContractor\nIntern\nVolunteer\nTemporary Worker\nBoard Member\nDirector\nPartner\nExternal Contact"
    },
    {
      "fieldname": "section_break_items",
      "fieldtype": "Section Break",
      "label": "Tasks"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "label": "Tasks",
      "options": "Checklist Template Item",
      "required": true
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "share": true,
      "print": true,
      "email": true
    }
  ]
}
