{
  "name": "Access Card",
  "module": "Administration",
  "autoname": "field:card_number",
  "is_submittable": false,
  "istable": false,
  "track_changes": false,
  "fields": [
    {
      "fieldname": "card_number",
      "fieldtype": "Data",
      "in_list_view": 1,
      "label": "Card / Badge Number",
      "unique": 1,
      "required": true
    },
    {
      "default": "Employee ID",
      "fieldname": "card_type",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Type",
      "options": "Employee ID\nVisitor Badge\nVehicle Sticker\nKey Fob\nOther",
      "required": true
    },
    {
      "fieldname": "column_break_top",
      "fieldtype": "Column Break"
    },
    {
      "default": "Issued",
      "fieldname": "status",
      "fieldtype": "Select",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "label": "Status",
      "options": "Issued\nReturned\nLost\nDeactivated",
      "read_only": 1
    },
    {
      "fieldname": "location",
      "fieldtype": "Link",
      "label": "Location",
      "options": "Office Location"
    },
    {
      "fieldname": "section_break_holder",
      "fieldtype": "Section Break",
      "label": "Holder"
    },
    {
      "fieldname": "person",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Person",
      "options": "Person",
      "required": true
    },
    {
      "default": "Today",
      "fieldname": "issue_date",
      "fieldtype": "Date",
      "label": "Issue Date",
      "required": true
    },
    {
      "fieldname": "column_break_holder",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "return_date",
      "fieldtype": "Date",
      "label": "Return Date",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": true,
      "write": true,
      "create": true,
      "delete": true,
      "report": true,
      "export": true,
      "share": true,
      "print": true,
      "email": true
    },
    {
      "role": "All",
      "read": true
    }
  ]
}
