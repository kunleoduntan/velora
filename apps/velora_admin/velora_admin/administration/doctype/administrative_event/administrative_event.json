{
  "name": "Administrative Event",
  "module": "Administration",
  "autoname": "field:title",
  "istable": false,
  "is_submittable": false,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Event Name",
      "fieldtype": "Data",
      "required": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "event_type",
      "label": "Event Type",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "start_datetime",
      "label": "Start",
      "fieldtype": "Datetime",
      "required": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "end_datetime",
      "label": "End",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "venue",
      "label": "Venue",
      "fieldtype": "Link",
      "options": "Facility"
    },
    {
      "fieldname": "organizer",
      "label": "Organizer",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Planning\nConfirmed\nIn Progress\nCompleted\nCancelled",
      "default": "Planning",
      "in_list_view": 1
    },
    {
      "fieldname": "budget",
      "label": "Budget",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "actual_cost",
      "label": "Actual Cost",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "attendees_json",
      "label": "Attendees JSON",
      "fieldtype": "Text",
      "options": "JSON"
    },
    {
      "fieldname": "checklist_json",
      "label": "Checklist JSON",
      "fieldtype": "Text",
      "options": "JSON"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1
    }
  ]
}
