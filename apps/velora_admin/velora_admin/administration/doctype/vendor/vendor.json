{
  "name": "Vendor",
  "module": "Administration",
  "autoname": "field:title",
  "istable": false,
  "is_submittable": false,
  "track_changes": true,
  "fields": [
    {
      "fieldname": "title",
      "label": "Vendor Name",
      "fieldtype": "Data",
      "required": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "vendor_category",
      "label": "Category",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "contact_person",
      "label": "Contact Person",
      "fieldtype": "Data"
    },
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data"
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "address",
      "label": "Address",
      "fieldtype": "Text"
    },
    {
      "fieldname": "tax_id",
      "label": "Tax ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Prospective\nActive\nOn Hold\nInactive",
      "default": "Prospective",
      "in_list_view": 1
    },
    {
      "fieldname": "qualification_status",
      "label": "Qualification",
      "fieldtype": "Select",
      "options": "Not Started\nPending\nQualified\nRejected\nExpired",
      "default": "Not Started"
    },
    {
      "fieldname": "contract_start",
      "label": "Contract Start",
      "fieldtype": "Date"
    },
    {
      "fieldname": "contract_end",
      "label": "Contract End",
      "fieldtype": "Date"
    },
    {
      "fieldname": "service_rating",
      "label": "Service Rating",
      "fieldtype": "Float"
    },
    {
      "fieldname": "documents_json",
      "label": "Document References JSON",
      "fieldtype": "Text",
      "options": "JSON"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Text"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "share": 1
    }
  ]
}
